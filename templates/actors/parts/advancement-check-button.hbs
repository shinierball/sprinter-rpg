{{!-- Ad hoc Advancement Check button of a skill or spell row. Params: row --}}
<button type="button" class="cog-attack-roll-btn cog-bg-info-fill cog-text-on-fill" data-action="advancementCheck" data-item-id="{{row.id}}" data-tooltip="Advancement Check: roll d20 &ge; Rank {{row.baseRank}}. Clears the Used mark." style="font-size: 10px; padding: 2px 6px;">
  <i class="fa-solid fa-chart-line"></i>
</button>
