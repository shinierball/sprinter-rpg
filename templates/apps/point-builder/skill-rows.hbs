<!-- 3. Skills & Spells: inline rows. Row controls carry no `name`; they write the spec through setRowField. -->
<section class="cog-builder-section">
  <div class="cog-section-title">
    <i class="fa-solid fa-graduation-cap"></i> 3. Skills & Spells
    <span class="cog-section-badge">+2 BP per Rank | Max 5 Ranks of Passives</span>
  </div>

  {{#if ledger.isPassiveExceeded}}
    <div class="cog-alert-banner warning">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span>Passive Skill ranks exceed standard limit ({{ledger.passiveSkillRanks}} / 5 Ranks max). Allowed under GM discretion.</span>
    </div>
  {{/if}}

  <div class="cog-entry-list">
    {{#each skillRows}}
      <div class="cog-entry-adder-row cog-pb-row" data-row="skills" data-index="{{@index}}">
        <select id="{{@root.rootId}}-skills-{{@index}}-identifier" data-change-action="setRowField" data-row-field="identifier" title="Pick a skill from the catalog, or leave it custom">
          {{#each this.identifierOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=this.identifierBadge}}
        <input type="text" id="{{@root.rootId}}-skills-{{@index}}-name" data-input-action="setRowField" data-change-action="setRowField" data-row-field="name" value="{{this.name}}" placeholder="Skill name">
        <select id="{{@root.rootId}}-skills-{{@index}}-rank" data-change-action="setRowField" data-row-field="rank">
          {{#each this.rankOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
        <label class="cog-checkbox-label" title="Passive skill points cannot exceed 5 ranks total in any build">
          <input type="checkbox" id="{{@root.rootId}}-skills-{{@index}}-isPassive" data-change-action="setRowField" data-row-field="isPassive" {{#if this.isPassive}}checked{{/if}}>
          <span>Passive</span>
        </label>
        {{#if this.unfilled}}<span class="cog-param-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "COG.PointBuilder.Unfilled"}}</span>{{/if}}
        <span class="cog-entry-cost">+{{this.cost}} BP</span>
        <button type="button" class="cog-btn-icon cog-remove-skill-btn" data-action="removeSkillRow" data-index="{{@index}}" title="Remove"><i class="fa-solid fa-trash"></i></button>
      </div>
    {{/each}}
  </div>
  <div class="cog-entry-adder-row">
    <button type="button" id="{{@root.rootId}}-add-skill" class="cog-btn cog-add-skill-btn" data-action="addSkillRow"><i class="fa-solid fa-plus"></i> Add Skill</button>
  </div>

  <div class="cog-entry-list">
    {{#each spellRows}}
      <div class="cog-entry-adder-row cog-pb-row" data-row="spells" data-index="{{@index}}">
        <select id="{{@root.rootId}}-spells-{{@index}}-identifier" data-change-action="setRowField" data-row-field="identifier" title="Pick a spell from the catalog, or leave it custom">
          {{#each this.identifierOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=this.identifierBadge}}
        <input type="text" id="{{@root.rootId}}-spells-{{@index}}-name" data-input-action="setRowField" data-change-action="setRowField" data-row-field="name" value="{{this.name}}" placeholder="Spell name">
        <select id="{{@root.rootId}}-spells-{{@index}}-rank" data-change-action="setRowField" data-row-field="rank">
          {{#each this.rankOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
        <label class="cog-checkbox-label">
          <input type="checkbox" id="{{@root.rootId}}-spells-{{@index}}-isPassive" data-change-action="setRowField" data-row-field="isPassive" {{#if this.isPassive}}checked{{/if}}>
          <span>Passive</span>
        </label>
        {{#if this.unfilled}}<span class="cog-param-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "COG.PointBuilder.Unfilled"}}</span>{{/if}}
        <span class="cog-entry-cost">+{{this.cost}} BP</span>
        <button type="button" class="cog-btn-icon cog-remove-spell-btn" data-action="removeSpellRow" data-index="{{@index}}" title="Remove"><i class="fa-solid fa-trash"></i></button>
      </div>
    {{/each}}
  </div>
  <div class="cog-entry-adder-row">
    <button type="button" id="{{@root.rootId}}-add-spell" class="cog-btn cog-add-spell-btn" data-action="addSpellRow"><i class="fa-solid fa-wand-magic-sparkles"></i> Add Spell</button>
  </div>

  <div class="cog-subsection-title">{{localize "COG.PointBuilder.RankBonuses"}}</div>
  {{> "systems/sprinter-rpg/templates/apps/point-builder/spec-grant-rows.hbs" list="rankBonuses" rows=rankBonusRows addAction="addRankBonusRow" removeAction="removeRankBonusRow" addLabel=(localize "COG.PointBuilder.AddRankBonus")}}
</section>
