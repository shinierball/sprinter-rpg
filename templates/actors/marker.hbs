<section class="cog-marker-sheet">
  <img class="cog-bg-icon-box profile-img" src="{{actor.img}}" alt="{{actor.name}}" width="48" height="48" />
  <h2>{{actor.name}}</h2>
  <p class="cog-text-secondary">
    {{#if lightOwnerName}}Carries the lights of <strong>{{lightOwnerName}}</strong>.{{else}}Carries light tokens. Its owner is gone.{{/if}}
  </p>
</section>
