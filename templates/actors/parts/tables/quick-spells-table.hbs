{{!-- PAGE 1: the quick SPELLS table. The columns come from @root.tables.quickSpells (src/utils/ui/sheet-columns.mjs). --}}
<div class="cog-lean-table-wrap">
<table class="cog-attacks-table cog-quick-spells-table cog-lean-table">
  <thead>
    <tr>
      {{#each @root.tables.quickSpells.columns as |col|}}
        <th class="cog-col {{col.cssClass}}"{{#if col.tip}} data-tooltip-text="{{col.tip}}"{{/if}}>{{col.label}}</th>
      {{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each spells as |spell|}}
      <tr class="draggable" data-item-id="{{spell.id}}" draggable="true">
        <td class="cog-col-name">
          <div style="display: flex; align-items: center; gap: 6px;">
            <img class="cog-bg-icon-box" src="{{spell.img}}" width="20" height="20" style="border: none; border-radius: 2px;" />
            <button type="button" class="cog-row-name" data-action="toggleDefinition" data-item-id="{{spell.id}}" data-definition-key="quick:{{spell.id}}" aria-expanded="{{#if spell.quick.definitionOpen}}true{{else}}false{{/if}}"{{#unless spell.quick.definitionOpen}}{{#if spell.summaryTip}} data-tooltip-text="{{spell.summaryTip}}" data-tooltip-class="cog-tooltip-lines"{{/if}}{{/unless}}><i class="fa-solid {{#if spell.quick.definitionOpen}}fa-chevron-down{{else}}fa-chevron-right{{/if}} cog-row-chevron"></i> {{spell.name}}</button>
            {{#if spell.isOffline}}<span class="cog-state-badge cog-badge-undone" data-tooltip-text="{{spell.offlineTip}}">[OFFLINE]</span>{{/if}}
          </div>
        </td>
        {{#if @root.tables.quickSpells.show.mana}}
        <td class="cog-col-mana">
          <span class="cog-text-info" style="font-size: 11px; font-weight: bold;">{{spell.system.manaCost}} MP</span>
          <small class="cog-text">({{upper spell.system.stat}} {{spell.statModStr}})</small>
        </td>
        {{/if}}
        {{#if @root.tables.quickSpells.show.damage}}
        <td class="cog-col-damage">
          {{#if spell.hasDamage}}
            <button type="button" class="cog-attack-roll-btn roll-spell-dmg cog-bg-accent-fill cog-text-on-fill" data-action="rollSpellDamage" data-tooltip-text="Roll Damage ({{spell.damageFormula}})" style="font-size: 10px; padding: 2px 6px;">
              {{spell.damageDice}} {{spell.damageType}}
            </button>
          {{else}}
            <span style="font-size: 11px;">{{spell.roleLabel}}</span>
          {{/if}}
        </td>
        {{/if}}
        {{#if @root.tables.quickSpells.show.range}}
        <td class="cog-col-range">
          <span style="font-size: 11px;">{{spell.system.range}}</span>
        </td>
        {{/if}}
        <td class="cog-col-actions" style="text-align: center; white-space: nowrap;">
          <button type="button" class="cog-attack-roll-btn roll-spell" data-action="rollSpell" data-tooltip-text="Cast {{spell.name}}" style="font-size: 10px; padding: 2px 6px;">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Cast
          </button>
          <a class="item-edit" data-action="editItem" data-tooltip="Edit Spell" style="margin-left: 3px; cursor: pointer;"><i class="fa-solid fa-edit"></i></a>
          <a class="item-delete cog-text-accent" data-action="deleteItem" data-tooltip="Delete Spell" style="margin-left: 3px; cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
        </td>
      </tr>
      {{#if spell.quick.definitionOpen}}
        {{> "systems/sprinter-rpg/templates/actors/parts/tables/definition-row.hbs" row=spell.quick span=@root.tables.quickSpells.span}}
      {{/if}}
    {{/each}}
  </tbody>
</table>
</div>
