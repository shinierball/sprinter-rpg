{{!-- The definition window of one spell or skill. Context built in apps/item-definition-app.mjs. No name attributes: nothing here is a form input. --}}
<div class="cog-item-definition-body">
  <header class="cog-item-definition-header">
    {{#if img}}<img class="cog-bg-icon-box cog-item-definition-img" src="{{img}}" alt="" width="36" height="36">{{/if}}
    <div class="cog-item-definition-heading">
      <div class="cog-item-definition-name">{{name}}</div>
      {{#if typeLabel}}<div class="cog-item-definition-type">{{typeLabel}}</div>{{/if}}
    </div>
  </header>
  {{> "systems/sprinter-rpg/templates/shared/item-definition.hbs" def=def}}
</div>
