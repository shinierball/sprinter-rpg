<div class="cog-manager-body cog-bg-surface-muted" style="flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px;">
  {{#if items.length}}
    {{#each items as |item|}}
      <div class="cog-item-card-row cog-item-card-draggable cog-bg-surface-muted cog-text" data-item-name="{{item.name}}" data-item-id="{{item.id}}" draggable="true" style="border: 1px solid var(--cog-panel-border); border-left: 4px solid {{item.badgeColor}}; border-radius: 4px; padding: 8px 10px; display: flex; flex-direction: column; gap: 4px; cursor: grab;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <img class="cog-bg-icon-box" src="{{item.img}}" style="width: 34px; height: 34px; border: 1px solid var(--cog-ink); border-radius: 3px; object-fit: contain;" />
            <div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <span class="cog-text-strong" style="font-size: 14px; font-weight: bold;">{{item.name}}</span>
                {{#if item.isCompendium}}
                  <span class="cog-badge cog-bg-window cog-text-gold" style="border: 1px solid var(--cog-gold); font-size: 9px; padding: 0 4px;" title="{{localize "COG.Content.ItemCompendiumBadge"}}">CANONICAL</span>
                {{/if}}
              </div>
              <div style="display: flex; gap: 4px; align-items: center; margin-top: 2px; flex-wrap: wrap;">
                <span class="cog-badge cog-bg-dyn cog-text-on-fill" style="--cog-bg-dyn: {{item.badgeColor}}; font-size: 9px; padding: 1px 4px;">{{item.badgeLabel}}</span>
                {{#if (eq item.type 'gear')}}
                  <span class="cog-badge cog-dark cog-bg-header-fill cog-text-on-fill" style="font-size: 9px; padding: 1px 4px; text-transform: uppercase;">SLOT: {{item.slot}}</span>
                {{/if}}
                {{> "systems/sprinter-rpg/templates/apps/partials/cooldown-badge.hbs" badge=item.cooldownBadge}}
                <span class="cog-badge cog-bg-gold-fill cog-text-on-fill" style="font-size: 9px; padding: 1px 4px;">
                  <i class="fa-solid fa-coins"></i> {{item.displayValue}}
                </span>
                {{#if item.mechanicsSummary}}
                  <span class="cog-badge cog-bg-surface-strong cog-text-strong" style="font-size: 9px; padding: 1px 4px;">{{item.mechanicsSummary}}</span>
                {{/if}}
              </div>
            </div>
          </div>

          <div style="display: flex; gap: 6px; align-items: center;">
            <button type="button" data-action="previewItem" class="btn-preview-item cog-btn cog-dark cog-bg-header-fill cog-text-on-fill" data-item-name="{{item.name}}" title="Inspect Item Sheet" style="font-size: 11px; padding: 4px 8px; border: 1px solid var(--cog-ink); border-radius: 3px; cursor: pointer;">
              <i class="fa-solid fa-eye"></i> Preview
            </button>
            {{#if ../actor}}
              {{#if item.isOwned}}
                <span class="cog-badge cog-bg-success-fill cog-text-on-fill" style="font-size: 11px; padding: 4px 8px; border-radius: 3px;">
                  <i class="fa-solid fa-check"></i> Owned (x{{item.ownedQty}})
                </span>
                <button type="button" data-action="addItem" class="btn-add-item cog-btn cog-bg-info-fill cog-text-on-fill" data-item-name="{{item.name}}" title="Add Another to Inventory" style="font-size: 11px; padding: 4px 8px; border: 1px solid var(--cog-ink); border-radius: 3px; font-weight: bold; cursor: pointer;">
                  <i class="fa-solid fa-plus"></i> Add More
                </button>
              {{else}}
                <button type="button" data-action="addItem" class="btn-add-item cog-btn cog-bg-accent-fill cog-text-on-fill" data-item-name="{{item.name}}" style="font-size: 11px; padding: 4px 8px; border: 1px solid var(--cog-ink); border-radius: 3px; font-weight: bold; cursor: pointer;">
                  <i class="fa-solid fa-plus"></i> Add to Inventory
                </button>
              {{/if}}
            {{/if}}
          </div>
        </div>

        {{#if item.descriptionSnippet}}
          <div class="cog-text-secondary" style="font-size: 11px; margin-top: 3px; padding-top: 3px; border-top: 1px dashed var(--cog-panel-border); font-family: sans-serif; line-height: 1.3;">
            {{item.descriptionSnippet}}
          </div>
        {{/if}}
      </div>
    {{/each}}
  {{else}}
    <div class="cog-text-secondary" style="text-align: center; padding: 40px 10px; font-style: italic;">
      No items or gear match the current filter criteria.
    </div>
  {{/if}}
</div>
