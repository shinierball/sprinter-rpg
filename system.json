{
  "id": "sprinter-rpg",
  "title": "Sprinter RPG",
  "description": "A Foundry VTT system for crawler-style dungeon roleplaying games.",
  "version": "7.0.0",
  "url": "https://github.com/shinierball/sprinter-rpg",
  "manifest": "https://github.com/shinierball/sprinter-rpg/releases/latest/download/system.json",
  "download": "https://github.com/shinierball/sprinter-rpg/releases/download/v7.0.0/sprinter-rpg.zip",
  "socket": true,
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "manifest": "https://github.com/farling42/foundryvtt-socketlib/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "1.1.0"
        }
      }
    ]
  },
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "16"
  },
  "documentTypes": {
    "Actor": {
      "crawler": {
        "htmlFields": [
          "details.notes",
          "details.pastTrauma",
          "details.looseEnds",
          "details.regrets"
        ]
      },
      "pet": {
        "htmlFields": [
          "special"
        ]
      },
      "mercenary": {
        "htmlFields": [
          "details.notes",
          "details.special"
        ]
      },
      "mount_vehicle": {},
      "marker": {},
      "personal_space": {
        "htmlFields": [
          "details.notes"
        ]
      },
      "npc": {
        "htmlFields": [
          "details.notes",
          "details.special"
        ]
      },
      "mob": {
        "htmlFields": [
          "details.notes",
          "details.special",
          "details.description",
          "details.aiDescription",
          "attributes.treasure"
        ]
      }
    },
    "Item": {
      "skill": {
        "htmlFields": [
          "notes",
          "description"
        ]
      },
      "attack": {
        "htmlFields": [
          "effects"
        ]
      },
      "spell": {
        "htmlFields": [
          "description",
          "quote"
        ]
      },
      "gear": {
        "htmlFields": [
          "notes",
          "description"
        ]
      },
      "race": {
        "htmlFields": [
          "abilities",
          "description"
        ]
      },
      "class": {
        "htmlFields": [
          "abilities",
          "description"
        ]
      },
      "deity": {
        "htmlFields": [
          "boons",
          "description"
        ]
      },
      "sponsor": {
        "htmlFields": [
          "gifts",
          "notes"
        ]
      },
      "loot": {
        "htmlFields": [
          "notes",
          "description"
        ]
      },
      "buff": {
        "htmlFields": [
          "description"
        ]
      },
      "debuff": {
        "htmlFields": [
          "description"
        ]
      },
      "achievement": {
        "htmlFields": [
          "description",
          "quote",
          "rewardContents"
        ]
      },
      "space_upgrade": {}
    },
    "RegionBehavior": {
      "zeroZone": {}
    }
  },
  "authors": [
    {
      "name": "shinierball and contributors"
    }
  ],
  "license": "LICENSE",
  "scripts": [
    "lib/pdf-lib.min.js"
  ],
  "esmodules": [
    "src/cog.mjs"
  ],
  "styles": [
    "styles/tokens.css",
    "styles/sheets.css",
    "styles/apps-library.css",
    "styles/chat.css",
    "styles/combat.css",
    "styles/apps-session.css",
    "styles/huds.css",
    "styles/apps-creators.css",
    "styles/apps-journal.css",
    "styles/apps-mob-creator.css",
    "styles/utilities.css",
    "styles/apps-floor-vehicle.css",
    "styles/loot-box.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "attributes.hp",
  "packs": [
    {
      "name": "skills",
      "label": "Skills",
