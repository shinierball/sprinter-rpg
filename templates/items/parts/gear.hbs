<section class="cog-item-body cog-item-body-gear">
{{#if brokenState}}
<div class="cog-field-row" style="margin-bottom: 8px; align-items: center;">
  <span class="cog-badge cog-bg-danger-fill cog-text-on-fill" style="font-size: 11px; padding: 2px 6px; border-radius: 2px;">{{brokenLabel}}</span>
  {{#if canRepair}}
  <button type="button" class="cog-btn cog-bg-warning-fill cog-text-on-fill" data-action="repairItem" data-tooltip="{{localize "COG.Repair.Tooltip"}}" style="margin-left: 8px; font-size: 11px; padding: 3px 8px; border-radius: 3px; cursor: pointer;"><i class="fa-solid fa-screwdriver-wrench"></i> {{localize "COG.Repair.Button"}}</button>
  {{/if}}
</div>
{{/if}}
<div class="cog-field-row" style="margin-bottom: 8px; align-items: center;">
  <div class="cog-field-group">
    <span class="cog-field-label">Slot</span>
    <select name="system.slot" class="cog-field-input">
      {{#each gearSlotOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
    </select>
  </div>
  <div class="cog-field-group small" style="text-align: center;">
    <span class="cog-field-label">Equipped</span>
    <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;">
      <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}} class="cog-checkbox-lg" />
    </label>
  </div>
  <div class="cog-field-group small" style="text-align: center;">
    <span class="cog-field-label">Is Weapon</span>
    <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;">
      <input type="checkbox" name="system.isWeapon" {{#if isWeaponChecked}}checked{{/if}} class="cog-checkbox-lg" />
    </label>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">Damage Resist (DR)</span>
    <input class="cog-field-input" type="number" name="system.drBonus" value="{{system.drBonus}}" placeholder="0" title="DR bonus or penalty (+/-)" />
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">Quantity</span>
    <input class="cog-field-input" type="number" name="system.quantity" value="{{system.quantity}}" />
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label"><i class="fa-solid fa-coins cog-text-gold"></i> Gold Value</span>
    {{#if isGM}}
      <input class="cog-field-input cog-bd-warning-fill" type="number" name="system.value" value="{{system.value}}" min="0" placeholder="0" title="Game Master: Gold Value is editable" style="font-weight: bold;" />
    {{else}}
      {{#if canSeeItemValue}}
        <input class="cog-field-input cog-bg-surface-alt cog-text" type="number" value="{{system.value}}" disabled readonly title="Player: Inspected value (Editable by GM only)" style="cursor: not-allowed;" />
      {{else}}
        <input class="cog-field-input cog-bg-surface-muted cog-text-muted" type="text" value="???" disabled readonly title="Requires Determine Value Rank 15 to inspect gold value (Editable by GM only)" style="text-align: center; font-style: italic; cursor: not-allowed;" />
      {{/if}}
    {{/if}}
  </div>
</div>

{{!-- WEAPON PROFICIENCY & HANDLING --}}
{{#if isWeaponChecked}}
<details class="cog-collapsible-block" {{#if hasProficiencyConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary cog-bg-accent-strong-fill">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-crosshairs"></i> WEAPON PROFICIENCY & HANDLING</span>
    <span class="cog-toggle-indicator {{#if hasProficiencyConfigured}}active{{/if}}">{{#if hasProficiencyConfigured}}[{{or system.weaponCategory system.weaponType "CONFIGURED"}}]{{else}}[CLICK TO CONFIGURE PROFICIENCY]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row" style="margin-bottom: 6px;">
      <div class="cog-field-group">
        <span class="cog-field-label">Weapon Category</span>
        <select name="system.weaponCategory" class="cog-field-input" style="font-size: 11px;">
          {{#each weaponCategoryOptions as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="cog-field-group">
        <span class="cog-field-label">Weapon Type / Model</span>
        <select name="system.weaponType" class="cog-field-input" style="font-size: 11px;">
          <option value="">-- None / Select Weapon Type --</option>
          {{#each weaponTypeOptions as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="cog-field-group">
        <span class="cog-field-label">Wielding Requirement</span>
        <select name="system.wieldMode" class="cog-field-input" style="font-size: 11px;">
          {{#each wieldModeOptions as |wm|}}
            <option value="{{wm.value}}" {{#if wm.selected}}selected{{/if}}>{{wm.label}}</option>
          {{/each}}
        </select>
      </div>
      {{#if (eq system.wieldMode "two_handed_disadv_1h")}}
      <div class="cog-field-group">
        <label><input type="checkbox" name="system.wieldedOneHanded" {{checked system.wieldedOneHanded}}> Wielded one-handed (disadvantage)</label>
      </div>
      {{/if}}
    </div>

    <div class="cog-field-row" style="margin-bottom: 8px;">
      <div class="cog-field-group">
        <span class="cog-field-label">To-Hit Stat</span>
        <select name="system.toHitStat" class="cog-field-input" style="font-size: 11px;">
          {{#each toHitStatOptions as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="cog-field-group">
        <span class="cog-field-label">To-Hit Rank</span>
        <input class="cog-field-input" type="number" min="0" name="system.toHitRank" value="{{system.toHitRank}}" style="font-size: 11px;" />
      </div>
    </div>

    <div class="cog-field-row" style="margin-bottom: 8px;">
      <div class="cog-field-group" style="flex: 2;">
        <span class="cog-field-label">Proficiency Mode</span>
        <select name="system.proficiencyMode" class="cog-field-input" style="font-size: 11px;">
          {{#each proficiencyModeOptions as |pm|}}
            <option value="{{pm.value}}" {{#if pm.selected}}selected{{/if}}>{{pm.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label"><i class="fa-solid fa-burst cog-text-accent"></i> Crit Multiplier</span>
        <input class="cog-field-input" type="number" name="system.critMultiplier" value="{{#if system.critMultiplier}}{{system.critMultiplier}}{{else}}1{{/if}}" placeholder="1" min="1" style="font-size: 11px;" title="Critical Hit Multiplier (defaults to 1x, adjustable by GM)" />
      </div>
      <div class="cog-field-group small" style="text-align: center; max-width: 90px;">
        <span class="cog-field-label">Armor Pierce</span>
        <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;" title="Check if this weapon penetrates armor and ignores Damage Resistance (DR)">
          <input type="checkbox" name="system.ignoreDR" {{#if system.ignoreDR}}checked{{/if}} class="cog-checkbox-lg" />
        </label>
      </div>
    </div>

    {{!-- ASSOCIATED SKILLS DATA-DRIVEN PICKER --}}
    <div class="cog-bg-surface" style="margin-bottom: 8px; border: 1px solid var(--cog-border-muted); border-radius: 3px; padding: 6px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
        <span class="cog-field-label cog-text" style="font-weight: bold;"><i class="fa-solid fa-graduation-cap"></i> Associated Weapon Skills</span>
        <button type="button" class="cog-btn cog-bg-success-fill cog-text-on-fill" data-action="applyRecommendedSkills" title="Auto-populate recommended skills for this weapon type" style="font-size: 10px; padding: 2px 6px; border: 1px solid var(--cog-success-fill); border-radius: 3px; cursor: pointer;">
          <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-Suggest Skills
        </button>
      </div>

      {{!-- Selected skills as removable tags --}}
      <div class="cog-associated-skills-pills cog-bg-surface-alt" style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; min-height: 24px; padding: 3px; border: 1px dashed var(--cog-border-muted); border-radius: 3px;">
        {{#if associatedSkillsPills.length}}
          {{#each associatedSkillsPills as |sk|}}
            <span class="cog-badge cog-skill-pill cog-dark cog-bg-header-fill cog-text-on-fill" style="font-size: 11px; padding: 2px 6px; border-radius: 3px; display: inline-flex; align-items: center; gap: 4px;">
              {{sk.label}}
              <a class="cog-text-danger" data-action="removeAssociatedSkill" data-skill="{{sk.value}}" title="Remove skill" style="cursor: pointer; font-weight: bold; text-decoration: none;">&times;</a>
            </span>
          {{/each}}
        {{else}}
          <span class="cog-text-muted" style="font-size: 10px; font-style: italic; align-self: center;">No associated skills selected yet. Select from the dropdown below or click Auto-Suggest.</span>
        {{/if}}
      </div>

      {{!-- Add Skill Controls --}}
      <div data-custom-entry style="display: flex; gap: 6px; align-items: center;">
        <div style="flex: 2;">
          <select class="cog-field-input" data-change-action="addAssociatedSkill" style="font-size: 11px; width: 100%;">
            <option value="">+ Select Existing Skill to Associate...</option>
            {{#each availableSkills as |s|}}
              <option value="{{#if s.system.identifier}}{{s.system.identifier}}{{else}}{{s.name}}{{/if}}">{{s.name}} ({{upper s.system.stat}} - {{s.groupLabel}})</option>
            {{/each}}
          </select>
        </div>
        <div style="flex: 1;">
          <input class="cog-field-input" type="text" placeholder="Or custom name..." style="font-size: 11px; width: 100%;" />
        </div>
        <button type="button" class="cog-btn cog-dark cog-bg-header-fill cog-text-on-fill" data-action="addCustomAssociatedSkill" style="font-size: 11px; padding: 3px 6px; border: 1px solid var(--cog-ink); border-radius: 3px; cursor: pointer;">
          + Add
        </button>
      </div>

    </div>

    {{!-- OPTIONAL EFFECTS / COMBAT TECHNIQUES DATA-DRIVEN PICKER --}}
    <div class="cog-bg-surface" style="margin-bottom: 8px; border: 1px solid var(--cog-border-muted); border-radius: 3px; padding: 6px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
        <span class="cog-field-label cog-text-accent" style="font-weight: bold;"><i class="fa-solid fa-burst"></i> Optional Effects / Combat Techniques</span>
        <button type="button" class="cog-btn cog-bg-warning-fill cog-text-on-fill" data-action="applyRecommendedEffects" title="Auto-populate recommended techniques for this weapon" style="font-size: 10px; padding: 2px 6px; border: 1px solid var(--cog-warning-fill); border-radius: 3px; cursor: pointer;">
          <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-Suggest Techniques
        </button>
      </div>

      {{!-- Selected techniques as removable tags --}}
      <div class="cog-optional-effects-pills cog-bg-surface-alt" style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; min-height: 24px; padding: 3px; border: 1px dashed var(--cog-border-muted); border-radius: 3px;">
        {{#if optionalEffectsList.length}}
          {{#each optionalEffectPills as |ef|}}
            <span class="cog-badge cog-bg-accent-fill cog-text-on-fill" style="font-size: 11px; padding: 2px 6px; border-radius: 3px; display: inline-flex; align-items: center; gap: 4px;">
              {{ef.label}}
              <a class="cog-dark cog-text-gold" data-action="removeOptionalEffect" data-effect="{{ef.id}}" title="Remove technique" style="cursor: pointer; font-weight: bold; text-decoration: none;">&times;</a>
            </span>
          {{/each}}
        {{else}}
          <span class="cog-text-muted" style="font-size: 10px; font-style: italic; align-self: center;">No optional effects or techniques associated.</span>
        {{/if}}
      </div>

      {{!-- Add Technique Controls --}}
      <div data-custom-entry style="display: flex; gap: 6px; align-items: center;">
        <div style="flex: 2;">
          <select class="cog-field-input" data-change-action="addOptionalEffect" style="font-size: 11px; width: 100%;">
            <option value="">+ Select Existing Technique/Effect...</option>
            {{#each availableTechniques as |tech|}}
              <option value="{{tech.system.identifier}}">{{tech.name}}</option>
            {{/each}}
          </select>
        </div>
        <div style="flex: 1;">
          <input class="cog-field-input" type="text" placeholder="Or technique identifier..." style="font-size: 11px; width: 100%;" />
        </div>
        <button type="button" class="cog-btn cog-bg-accent-strong-fill cog-text-on-fill" data-action="addCustomOptionalEffect" style="font-size: 11px; padding: 3px 6px; border: 1px solid var(--cog-ink); border-radius: 3px; cursor: pointer;">
          + Add
        </button>
      </div>

    </div>
  </div>
</details>

{{> "systems/sprinter-rpg/templates/items/parts/as-triggers.hbs"}}
{{/if}}


{{!-- STAT BONUSES (system.grants rows of kind stat: flat and percent, equipped only) --}}
<details class="cog-collapsible-block" {{#if statGrantRows.length}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-dumbbell"></i> STAT BONUSES (EQUIPPED ONLY)</span>
    <span class="cog-toggle-indicator {{#if statGrantRows.length}}active{{/if}}">{{#if statGrantRows.length}}[{{statGrantRows.length}} STAT BONUSES]{{else}}[CLICK TO ADD STAT BONUSES]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content" style="padding: 0;">
    {{> "systems/sprinter-rpg/templates/items/parts/stat-grant-rows.hbs"}}
  </div>
</details>

{{!-- SKILL / SPELL BONUSES (system.grants rows of kind skill | spell, by identifier) --}}
<details class="cog-collapsible-block" {{#if hasGearGrantsConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-graduation-cap"></i> SKILL & SPELL BONUSES / GRANTED SKILLS & SPELLS</span>
    <span class="cog-toggle-indicator {{#if hasGearGrantsConfigured}}active{{/if}}">{{#if hasGearGrantsConfigured}}[{{gearGrantRows.length}} GRANTED]{{else}}[CLICK TO ADD SKILL OR SPELL BONUSES]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
      <span style="font-size: 11px;">
        {{#if system.equipped}}
          <span class="cog-text-success" style="font-weight: bold;">[EQUIPPED: ACTIVE]</span>
        {{else}}
          <span class="cog-text-warning" style="font-weight: bold;" title="Equip this gear on the actor to activate skill and spell bonuses">[UNEQUIPPED: EQUIP TO ACTIVATE]</span>
        {{/if}}
      </span>
      <a class="cog-text-on-fill cog-dark cog-bg-header-fill" data-action="openSkillPicker" data-tooltip="{{localize "COG.Content.AddSkillFromCompendiumTooltip"}}" style="font-size: 11px; cursor: pointer; padding: 3px 8px; border-radius: 3px; display: inline-flex; align-items: center; gap: 4px; font-weight: bold;">
        <i class="fa-solid fa-book-bookmark"></i> {{localize "COG.Content.AddSkillFromCompendium"}}
      </a>
    </div>
    {{#if gearGrantRows.length}}
      <table class="cog-table" style="margin: 0; font-size: 11px;">
        <thead>
          <tr>
            <th style="width: 12%;">Kind</th>
            <th style="width: 50%;">Skill / Spell</th>
            <th style="width: 14%;">Rank Bonus</th>
            <th style="width: 14%;" title="Rank an unowned spell is granted at">Grant Rank</th>
            <th style="width: 10%;"></th>
          </tr>
        </thead>
        <tbody>
          {{#each gearGrantRows as |row|}}
            <tr>
              <td><span class="cog-badge">{{#if row.isSpell}}[SPELL]{{else}}[SKILL]{{/if}}</span>{{#if row.enchantment}} <span class="cog-badge cog-badge-info">{{localize "COG.CraftSheet.Badge.Enchantment"}}</span>{{/if}}</td>
              <td>
                <div style="display: flex; align-items: center; gap: 4px;">
                  <select class="cog-field-input" name="system.grants.{{row.idx}}.identifier" style="font-size: 11px; flex: 1;">
                    {{#each row.options as |opt|}}
                      <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </select>
                  {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=row.sourceBadge}}
                  {{#unless row.isSpell}}
                    <a class="cog-text" data-action="openSkillPicker" data-index="{{row.idx}}" data-tooltip="{{localize "COG.Content.PickFromCompendium"}}" style="cursor: pointer; padding: 2px 4px;"><i class="fa-solid fa-book-bookmark"></i></a>
                  {{/unless}}
                </div>
                <input class="cog-field-input" type="text" name="system.grants.{{row.idx}}.label" value="{{row.label}}" placeholder="{{localize "COG.Content.GrantLabelPlaceholder"}}" title="{{localize "COG.Content.GrantLabelTooltip"}}" style="font-size: 11px; width: 100%; margin-top: 3px;" />
              </td>
              <td>
                <input class="cog-stat-input" type="number" name="system.grants.{{row.idx}}.value" value="{{row.value}}" style="width: 100%; font-size: 11px;" />
              </td>
              <td>
                {{#if row.isSpell}}
                  <input class="cog-stat-input" type="number" min="1" step="1" name="system.grants.{{row.idx}}.rank" value="{{row.rank}}" style="width: 100%; font-size: 11px;" />
                  {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=row.cooldownEditor}}
                {{/if}}
              </td>
              <td style="text-align: center;">
                <a class="cog-text-accent" data-action="deleteRow" data-row-table="grant" data-index="{{row.idx}}" data-tooltip="Delete" style="cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <div class="cog-text-secondary cog-bg-surface" style="text-align: center; font-style: italic; font-size: 11px; padding: 6px; border: 1px dashed var(--cog-border-muted); border-radius: 3px;">
        {{localize "COG.Content.NoGearSkillBonuses"}}
      </div>
    {{/if}}
  </div>
</details>

{{!-- WEAPON / GEAR DAMAGE PARTS --}}
<details class="cog-collapsible-block" {{#if hasDamagePartsConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-burst"></i> WEAPON DAMAGE PARTS (WHEN USED/EQUIPPED)</span>
    <span class="cog-toggle-indicator {{#if hasDamagePartsConfigured}}active{{/if}}">{{#if hasDamagePartsConfigured}}[{{system.damageParts.length}} DAMAGE PARTS]{{else}}[CLICK TO ADD WEAPON DAMAGE]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div style="display: flex; justify-content: flex-end; margin-bottom: 6px;">
      <a class="cog-text-on-fill cog-dark cog-bg-header-fill" data-action="addRow" data-row-table="damagePart" style="font-size: 11px; cursor: pointer; font-weight: bold; padding: 3px 8px; border-radius: 3px; display: inline-flex; align-items: center; gap: 4px;">
        <i class="fa-solid fa-plus"></i> Add Damage Part
      </a>
    </div>
    {{#if system.damageParts.length}}
      <table class="cog-table" style="margin: 0; font-size: 11px;">
        <thead>
          <tr>
            <th style="width: 25%;">Dice</th>
            <th style="width: 20%;">Stat</th>
            <th style="width: 30%;">Damage Type</th>
            <th style="width: 20%;">Flat Value</th>
            <th style="width: 5%;"></th>
          </tr>
        </thead>
        <tbody>
          {{#each system.damageParts as |part idx|}}
            <tr>
              <td>
                <input class="cog-field-input" type="text" name="system.damageParts.{{idx}}.dice" value="{{part.dice}}" placeholder="1d6" style="width: 100%; font-size: 11px;" />
              </td>
              <td>
                <select class="cog-field-input" name="system.damageParts.{{idx}}.stat" style="font-size: 11px;">
                  {{#each part.statOptions as |opt|}}
                    <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                  {{/each}}
                </select>
              </td>
              <td>
                <select class="cog-field-input" name="system.damageParts.{{idx}}.type" style="font-size: 11px;">
                  {{#each part.typeOptions as |opt|}}
                    <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                  {{/each}}
                </select>
              </td>
              <td>
                <input class="cog-stat-input" type="number" name="system.damageParts.{{idx}}.value" value="{{part.value}}" placeholder="0" style="width: 100%; font-size: 11px;" />
              </td>
              <td style="text-align: center;">
                <a class="cog-text-accent" data-action="deleteRow" data-row-table="damagePart" data-index="{{idx}}" data-tooltip="Delete" style="cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <div class="cog-text-secondary cog-bg-surface" style="text-align: center; font-style: italic; font-size: 11px; padding: 6px; border: 1px dashed var(--cog-border-muted); border-radius: 3px;">
        No bonus weapon damage parts. Click "Add Damage Part" above to add weapon damage (e.g. +2 Necrotic, +4 Sonic).
      </div>
    {{/if}}
  </div>
</details>

{{!-- AURA & AREA OF EFFECT EMISSION (GEAR AURA) --}}
<details class="cog-collapsible-block" {{#if hasAuraConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-circle-notch"></i> PASSIVE / ACTIVATED AURA EMISSION</span>
    <span class="cog-toggle-indicator {{#if hasAuraConfigured}}active{{/if}}">{{#if hasAuraConfigured}}[AURA CONFIGURED]{{else}}[CLICK TO CONFIGURE GEAR AURA]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row" style="margin-bottom: 6px; align-items: center; gap: 8px; flex-wrap: wrap;">
      <label class="cog-text" style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer;">
        <input type="checkbox" name="system.area.hasArea" {{#if system.area.hasArea}}checked{{/if}} />
        <span>Emits Aura When Equipped / Activated</span>
      </label>
      {{> "systems/sprinter-rpg/templates/items/parts/area-shape.hbs"}}
      <div class="cog-field-group small" style="flex: 1.2;">
        <span class="cog-field-label">Target Filter</span>
        <select class="cog-field-input" name="system.area.targetFilter" style="font-size: 11px;">
          <option value="allies" {{#if (eq system.area.targetFilter "allies")}}selected{{/if}}>Allies Only</option>
          <option value="enemies" {{#if (eq system.area.targetFilter "enemies")}}selected{{/if}}>Enemies Only</option>
          <option value="both" {{#if (eq system.area.targetFilter "both")}}selected{{/if}}>Both (Allies & Enemies)</option>
        </select>
      </div>
    </div>

    {{!-- Allied Protection / Temp Health Bars Sub-Block --}}
    <div class="cog-rank-break-card cog-bg-surface" style="margin-bottom: 6px; border: 1px solid var(--cog-divider); border-left: 4px solid var(--cog-success); padding: 6px; border-radius: 3px;">
      <div class="cog-text-success" style="font-weight: bold; font-size: 11px; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between;">
        <span><i class="fa-solid fa-shield-halved"></i> Allied Protection & Temporary Health Bars</span>
        <label class="cog-text" style="font-size: 10px; font-weight: normal; display: flex; align-items: center; gap: 4px; cursor: pointer;">
          <input type="checkbox" name="system.tempBars.hasTempBars" {{#if system.tempBars.hasTempBars}}checked{{/if}} />
          <span>Enable Bonus Health Bars</span>
        </label>
      </div>
      <div class="cog-field-row" style="gap: 6px;">
        <div class="cog-field-group" style="flex: 1.5;">
          <span class="cog-field-label">Bar Slots Formula / Stat</span>
          <select class="cog-field-input" name="system.tempBars.slotsFormula" style="font-size: 11px;">
            <option value="" {{#unless system.tempBars.slotsFormula}}selected{{/unless}}>Not set (1 Bar)</option>
            <option value="con" {{#if (eq system.tempBars.slotsFormula "con")}}selected{{/if}}>CON Mod</option>
            <option value="cha" {{#if (eq system.tempBars.slotsFormula "cha")}}selected{{/if}}>CHA Mod</option>
            <option value="int" {{#if (eq system.tempBars.slotsFormula "int")}}selected{{/if}}>INT Mod</option>
            <option value="str" {{#if (eq system.tempBars.slotsFormula "str")}}selected{{/if}}>STR Mod</option>
            <option value="dex" {{#if (eq system.tempBars.slotsFormula "dex")}}selected{{/if}}>DEX Mod</option>
            <option value="1" {{#if (eq system.tempBars.slotsFormula "1")}}selected{{/if}}>Fixed 1 Bar</option>
            <option value="2" {{#if (eq system.tempBars.slotsFormula "2")}}selected{{/if}}>Fixed 2 Bars</option>
          </select>
        </div>
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">Base HP Per Bar</span>
          <input class="cog-field-input" type="number" name="system.tempBars.hpPerSlot" value="{{system.tempBars.hpPerSlot}}" placeholder="2" min="0" style="font-size: 11px;" />
        </div>
      </div>
    </div>

    {{!-- Aura Combat Bonuses, Resistances & Granted Buffs Sub-Block --}}
    <div class="cog-rank-break-card cog-bg-surface" style="margin-bottom: 6px; border: 1px solid var(--cog-divider); border-left: 4px solid var(--cog-info); padding: 6px; border-radius: 3px;">
      <div class="cog-text-info" style="font-weight: bold; font-size: 11px; margin-bottom: 4px;">
        <i class="fa-solid fa-sparkles"></i> Aura Combat Bonuses, Resistances & Granted Buffs
      </div>
      <div class="cog-field-row" style="gap: 6px; margin-bottom: 4px;">
        <div class="cog-field-group small" style="flex: 1;">
          <span class="cog-field-label">Evade Bonus</span>
          <input class="cog-field-input" type="number" name="system.area.evadeBonus" value="{{system.area.evadeBonus}}" placeholder="0" style="font-size: 11px;" />
        </div>
        <div class="cog-field-group small" style="flex: 1;">
          <span class="cog-field-label">Attack Bonus</span>
          <input class="cog-field-input" type="number" name="system.area.attackBonus" value="{{system.area.attackBonus}}" placeholder="0" style="font-size: 11px;" />
        </div>
        <div class="cog-field-group small" style="flex: 1;">
          <span class="cog-field-label">Damage Bonus</span>
          <input class="cog-field-input" type="number" name="system.area.damageBonus" value="{{system.area.damageBonus}}" placeholder="0" style="font-size: 11px;" />
        </div>
      </div>
      <div class="cog-field-row cog-pick-row">
        {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=areaGrantedResistancesPicker}}
        {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=areaGrantedImmunitiesPicker}}
      </div>
      {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=areaGrantedBuffsPicker}}
    </div>

    {{!-- Aura Healing & Cleansing Sub-Block --}}
    <div class="cog-rank-break-card cog-bg-surface" style="margin-bottom: 6px; border: 1px solid var(--cog-divider); border-left: 4px solid var(--cog-success); padding: 6px; border-radius: 3px;">
      <div class="cog-text-success" style="font-weight: bold; font-size: 11px; margin-bottom: 4px;">
        <i class="fa-solid fa-heart-pulse"></i> Aura Healing & Cleansing
      </div>
      <div class="cog-field-row" style="gap: 6px; margin-bottom: 4px; align-items: center;">
        <div class="cog-field-group small" style="width: 80px;">
          <span class="cog-field-label">Healing Bars</span>
          <input class="cog-field-input" type="number" name="system.area.healingBars" value="{{system.area.healingBars}}" placeholder="0" min="0" style="font-size: 11px;" />
        </div>
        <label class="cog-text-info" style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer; margin-top: 10px;">
          <input type="checkbox" name="system.area.isHoT" {{#if system.area.isHoT}}checked{{/if}} />
          <span>Heal Over Time (HoT)</span>
        </label>
        <div class="cog-field-group small" style="width: 80px;">
          <span class="cog-field-label">HoT Rounds</span>
          <input class="cog-field-input" type="number" name="system.area.hotRounds" value="{{#if system.area.hotRounds}}{{system.area.hotRounds}}{{/if}}" placeholder="3" min="1" style="font-size: 11px;" />
        </div>
        {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=areaCleanseDebuffsPicker}}
      </div>
    </div>

    {{!-- Enemy Hazard / Periodic Aura Damage Sub-Block --}}
    <div class="cog-rank-break-card cog-bg-surface" style="border: 1px solid var(--cog-divider); border-left: 4px solid var(--cog-accent); padding: 6px; border-radius: 3px;">
      <div class="cog-text-accent" style="font-weight: bold; font-size: 11px; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between;">
        <span><i class="fa-solid fa-burst"></i> Enemy Hazard (Periodic Damage & Debuffs in Radius)</span>
        <label class="cog-text" style="font-size: 10px; font-weight: normal; display: flex; align-items: center; gap: 4px; cursor: pointer;">
          <input type="checkbox" name="system.area.hasPeriodicDamage" {{#if system.area.hasPeriodicDamage}}checked{{/if}} />
          <span>Enable Periodic Aura Damage</span>
        </label>
      </div>
      <div class="cog-field-row" style="gap: 6px; margin-bottom: 4px;">
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">Tick Damage Formula</span>
          <input class="cog-field-input" type="text" name="system.area.periodicDamageFormula" value="{{system.area.periodicDamageFormula}}" placeholder="e.g. 1d6" style="font-size: 11px;" />
        </div>
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">Damage Element</span>
          <select class="cog-field-input" name="system.area.periodicDamageType" style="font-size: 11px;">
            {{#each periodicDamageTypeOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=areaInflictedDebuffsPicker}}
      {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=areaPulseConditionsPicker}}
    </div>
  </div>
</details>

{{!-- COOLDOWN for gear whose rows (not an activated ability) use it; with an ability the editor is in its block below --}}
{{#if showStandaloneCooldown}}
<div class="cog-field-row" style="margin-bottom: 8px;" data-standalone-cooldown>
  <div class="cog-field-group">
    {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=cooldownEditor}}
  </div>
</div>
{{/if}}

{{!-- ACTIVATED ABILITY / ON-USE EFFECTS --}}
<details class="cog-collapsible-block" {{#if hasActivatedAbilityConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary cog-bg-accent-strong-fill">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-bolt"></i> ACTIVATED ABILITY / ON-USE EFFECTS</span>
    <span class="cog-toggle-indicator {{#if hasActivatedAbilityConfigured}}active{{/if}}">{{#if hasActivatedAbilityConfigured}}[ACTIVE ABILITY CONFIGURED]{{else}}[CLICK TO CONFIGURE ON-USE ABILITY]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <label class="cog-text" style="display: flex; align-items: center; gap: 4px; font-size: 11px; font-weight: bold; cursor: pointer;">
        <input type="checkbox"  name="system.hasActivatedAbility" {{#if system.hasActivatedAbility}}checked{{/if}} />
        <span>Enable Activated Ability / On-Use</span>
      </label>
    </div>
    {{> "systems/sprinter-rpg/templates/items/parts/usage-readout.hbs"}}
    {{#if (or system.hasActivatedAbility system.outcomes.length)}}
      <div class="cog-bg-surface-alt" style="padding: 6px; border: 1px solid var(--cog-divider); border-radius: 3px;">
        <div class="cog-field-row" style="margin-bottom: 6px;">
          <div class="cog-field-group">
            <span class="cog-field-label">Cast Spell</span>
            <select class="cog-field-input" name="system.spellIdentifier" style="font-size: 11px;">
              <option value="">-- None --</option>
              {{#each spellIdentifierOptions as |sp|}}
                <option value="{{sp.value}}" {{#if sp.selected}}selected{{/if}}>{{sp.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="cog-field-row" style="margin-bottom: 6px;">
          <div class="cog-field-group">
            {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=cooldownEditor}}
          </div>
          <div class="cog-field-group">
            <span class="cog-field-label">Execution Mode</span>
            <select class="cog-field-input" name="system.executionMode">
              <option value="all" {{#if (or (eq system.executionMode "all") (not system.executionMode))}}selected{{/if}}>All Effects (Guaranteed Combo)</option>
              <option value="random" {{#if (eq system.executionMode "random")}}selected{{/if}}>Weighted Random Outcome</option>
            </select>
          </div>
          <div class="cog-field-group small">
            <span class="cog-field-label">Charges (Pool)</span>
            <div style="display: flex; gap: 4px; align-items: center;">
              <input class="cog-field-input" type="number" name="system.charges.value" value="{{system.charges.value}}" min="0" style="text-align: center; width: 45px;" />
              <span>/</span>
              <input class="cog-field-input" type="number" name="system.charges.max" value="{{system.charges.max}}" min="0" style="text-align: center; width: 45px;" />
            </div>
          </div>
          <div style="display: flex; align-items: flex-end; padding-bottom: 2px;">
            <a class="cog-bg-accent-fill cog-text-on-fill" data-action="addGearOutcome" style="padding: 4px 8px; border-radius: 3px; font-size: 11px; text-decoration: none; cursor: pointer;">
              <i class="fa-solid fa-plus"></i> Add Effect
            </a>
          </div>
        </div>

        {{#if system.outcomes.length}}
          <table class="cog-table" style="width: 100%; font-size: 12px; margin-bottom: 0;">
            <thead>
              <tr class="cog-bg-surface-muted">
                <th style="width: 25%;">Effect Name</th>
                {{#if (eq system.executionMode "random")}}
                  <th style="width: 12%;">Weight</th>
                {{/if}}
                <th style="width: 18%;">Type</th>
                <th style="width: 16%;">Target</th>
                <th style="width: 25%;">Details / Values</th>
                <th style="width: 8%; text-align: center;">Act</th>
              </tr>
            </thead>
            <tbody>
              {{#each system.outcomes as |out idx|}}
                <tr style="border-bottom: 1px solid var(--cog-divider);">
                  <td>
                    <input class="cog-field-input" type="text" name="system.outcomes.{{idx}}.name" value="{{out.name}}" placeholder="Effect Name" style="width: 100%; font-size: 11px;" />
                  </td>
                  {{#if (eq ../system.executionMode "random")}}
                    <td>
                      <input class="cog-field-input" data-input-action="sanitizeWeight" type="number" name="system.outcomes.{{idx}}.weight" value="{{out.weight}}" min="0" max="100" data-index="{{idx}}" style="width: 100%; font-size: 11px;" />
                    </td>
                  {{/if}}
                  <td>
                    <select class="cog-field-input" data-index="{{idx}}" name="system.outcomes.{{idx}}.type" style="width: 100%; font-size: 11px;">
                      {{#each out.typeOptionsGear as |tOpt|}}<option value="{{tOpt.value}}" {{#if tOpt.selected}}selected{{/if}}>{{tOpt.label}}</option>{{/each}}
                    </select>
                  </td>
                  <td>
                    <select class="cog-field-input" name="system.outcomes.{{idx}}.targetType" style="width: 100%; font-size: 11px;">
                      <option value="self" {{#if out.targetSelf}}selected{{/if}}>Self</option>
                      <option value="closest_mob" {{#if out.targetIs.closest_mob}}selected{{/if}}>Closest Mob</option>
                      <option value="target" {{#if out.targetIs.target}}selected{{/if}}>Targeted Token</option>
                    </select>
                  </td>
                  <td>
                    {{#if (eq out.type "heal")}}
                      <div style="display: flex; gap: 4px; align-items: center;">
                        <input class="cog-field-input" type="number" name="system.outcomes.{{idx}}.healBars" value="{{out.healBars}}" placeholder="Bars" style="width: 50px; font-size: 11px;" />
                        <span style="font-size: 10px;">Bars</span>
                      </div>
                    {{else if (eq out.type "heal_over_time")}}
                      <div style="display: flex; gap: 4px; align-items: center;">
                        <input class="cog-field-input" type="number" name="system.outcomes.{{idx}}.healBars" value="{{out.healBars}}" placeholder="Bars" style="width: 40px; font-size: 11px;" />
                        <span style="font-size: 10px;">b/rnd</span>
                        <input class="cog-field-input" type="number" name="system.outcomes.{{idx}}.rounds" value="{{out.rounds}}" placeholder="3" style="width: 40px; font-size: 11px;" />
                        <span style="font-size: 10px;">rnds</span>
                      </div>
                    {{else if (eq out.type "restore_resource")}}
                      <div style="display: flex; gap: 4px; align-items: center;">
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.resource" style="width: 30%; font-size: 11px;">
                          {{#each out.resourceOptions as |rOpt|}}<option value="{{rOpt.value}}" {{#if rOpt.selected}}selected{{/if}}>{{rOpt.label}}</option>{{/each}}
                        </select>
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.mode" style="width: 35%; font-size: 11px;">
                          <option value="full" {{#if out.restoreFull}}selected{{/if}}>Full</option>
                          <option value="amount" {{#unless out.restoreFull}}selected{{/unless}}>Amount</option>
                        </select>
                        <input class="cog-field-input" type="number" name="system.outcomes.{{idx}}.amount" value="{{out.amount}}" placeholder="10" style="width: 35%; font-size: 11px;" />
                      </div>
                    {{else if (eq out.type "mend_injury")}}
                      <select class="cog-field-input" name="system.outcomes.{{idx}}.injurySeverity" style="width: 100%; font-size: 11px;">
                        <option value="minor" {{#if (eq out.injurySeverity "minor")}}selected{{/if}}>Minor Injury</option>
                        <option value="major" {{#if (eq out.injurySeverity "major")}}selected{{/if}}>Major Injury</option>
                        <option value="all" {{#if (eq out.injurySeverity "all")}}selected{{/if}}>All Injuries</option>
                      </select>
                    {{else if (eq out.type "cure_debuff")}}
                      {{> "systems/sprinter-rpg/templates/items/parts/outcome-cure-filter.hbs" out=out idx=idx}}
                    {{else if (eq out.type "skill_rank")}}
                      <div style="display: flex; gap: 4px; align-items: center;">
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.skillIdentifier" style="width: 70%; font-size: 11px;">
                      {{#each out.skillOptions as |sk|}}
                        <option value="{{sk.value}}" {{#if sk.selected}}selected{{/if}}>{{sk.label}}</option>
                      {{/each}}
                    </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=out.skillBadge}}
                        <input class="cog-field-input" type="number" name="system.outcomes.{{idx}}.rankBonus" value="{{out.rankBonus}}" placeholder="+1" style="width: 30%; font-size: 11px;" />
                      </div>
                    {{else if (eq out.type "learn_spell")}}
                      <div style="display: flex; gap: 4px; align-items: center;">
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.spellIdentifier" style="width: 70%; font-size: 11px;">
                          <option value="">-- Choose Spell --</option>
                          {{#each out.spellOptions as |sOpt|}}
                            <option value="{{sOpt.value}}" {{#if sOpt.selected}}selected{{/if}}>{{sOpt.label}}</option>
                          {{/each}}
                        </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=out.spellBadge}}
                        <input class="cog-field-input" type="number" min="1" name="system.outcomes.{{idx}}.rank" value="{{out.rank}}" placeholder="Rank 1" style="width: 30%; font-size: 11px;" />
                      </div>
                    {{else if (eq out.type "stat_permanent")}}
                      <div style="display: flex; gap: 4px; align-items: center;">
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.stat" style="width: 50%; font-size: 11px;">
                          {{#each out.statOptions as |so|}}
                            <option value="{{so.value}}" {{#if so.selected}}selected{{/if}}>{{so.label}}</option>
                          {{/each}}
                        </select>
                        <input class="cog-field-input" type="number" name="system.outcomes.{{idx}}.value" value="{{out.value}}" placeholder="+1" style="width: 50%; font-size: 11px;" />
                      </div>
                    {{else if (eq out.type "buff")}}
                      <select class="cog-field-input" data-change-action="selectOutcomeBuff" data-index="{{idx}}" name="system.outcomes.{{idx}}.buffIdentifier" style="width: 100%; font-size: 11px;">
                        <option value="">-- Choose Existing Buff --</option>
                        {{#each out.buffOptions as |bOpt|}}
                          <option value="{{bOpt.value}}" {{#if bOpt.selected}}selected{{/if}}>{{bOpt.label}}</option>
                        {{/each}}
                      </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=out.buffBadge}}
                    {{else if (eq out.type "debuff")}}
                      <select class="cog-field-input" data-change-action="selectOutcomeDebuff" data-index="{{idx}}" name="system.outcomes.{{idx}}.debuffIdentifier" style="width: 100%; font-size: 11px;">
                        <option value="">-- Choose Existing Debuff --</option>
                        {{#each out.debuffOptions as |dOpt|}}
                          <option value="{{dOpt.value}}" {{#if dOpt.selected}}selected{{/if}}>{{dOpt.label}}</option>
                        {{/each}}
                      </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=out.debuffBadge}}
                    {{else if (eq out.type "spell")}}
                      <select class="cog-field-input" data-change-action="selectOutcomeSpell" data-index="{{idx}}" name="system.outcomes.{{idx}}.spellIdentifier" style="width: 100%; font-size: 11px;">
                        <option value="">-- Choose Spell --</option>
                        {{#each out.spellOptions as |sOpt|}}
                          <option value="{{sOpt.value}}" {{#if sOpt.selected}}selected{{/if}}>{{sOpt.label}}</option>
                        {{/each}}
                      </select> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=out.spellBadge}}
{{> "systems/sprinter-rpg/templates/items/parts/outcome-spell-damage.hbs" out=out idx=idx}}
                    {{else if (eq out.type "roll_table")}}
                      <select class="cog-field-input" data-change-action="selectOutcomeTable" data-index="{{idx}}" name="system.outcomes.{{idx}}.tableUuid" style="width: 100%; font-size: 11px;">
                        <option value="">-- Choose Roll Table --</option>
                        {{#each out.tableOptions as |tOpt|}}
                          <option value="{{tOpt.uuid}}" {{#if tOpt.selected}}selected{{/if}}>{{tOpt.name}}</option>
                        {{/each}}
                      </select>
                    {{else if out.isEnchantItem}}
                      <span class="cog-text-secondary">{{localize "COG.CraftSheet.Outcome.Summary" count=out.enchantTemplates.length}}</span>
                    {{else}}
                      <div data-outcome-damage>
                      <div style="display: flex; gap: 4px;">
                        <input class="cog-field-input" data-input-action="checkOutcomeDamage" type="text" name="system.outcomes.{{idx}}.damage" value="{{out.damage}}" placeholder="NdM" style="width: 40%; font-size: 11px;" />
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.damageStat" data-tooltip="{{localize "COG.Item.OutcomeDamageStat"}}" style="width: 20%; font-size: 11px;">
                          {{#each out.damageStatOptions as |sOpt|}}
                            <option value="{{sOpt.value}}" {{#if sOpt.selected}}selected{{/if}}>{{sOpt.label}}</option>
                          {{/each}}
                        </select>
                        <select class="cog-field-input" name="system.outcomes.{{idx}}.damageType" style="width: 40%; font-size: 11px;">
                          <option value="">-- Type --</option>
                          {{#each out.damageTypeOptions as |dtOpt|}}
                            <option value="{{dtOpt.value}}" {{#if dtOpt.selected}}selected{{/if}}>{{dtOpt.label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div class="cog-text-accent" data-outcome-damage-warn {{#unless out.damageWarn}}hidden{{/unless}} style="font-size: 10px;">{{localize "COG.Item.OutcomeDamageNoRoll"}}</div>
                      </div>
                    {{/if}}
                  </td>
                  <td style="text-align: center;">
                    <a class="cog-text-accent" data-action="deleteGearOutcome" data-index="{{idx}}" style="cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
                  </td>
                </tr>
                <tr>
                  <td colspan="{{#if (eq ../system.executionMode "random")}}6{{else}}5{{/if}}" style="padding-bottom: 6px; padding-top: 2px;">
                    <input class="cog-field-input" type="text" name="system.outcomes.{{idx}}.description" value="{{out.description}}" placeholder="Flavor & rules description..." style="width: 100%; font-size: 11px;" />
                  </td>
                </tr>
            {{#if out.isEnchantItem}}
              <tr>
                <td colspan="6" class="cog-outcome-enchant-table">
                  <label class="cog-text-secondary" style="font-size: 11px;">{{localize "COG.Outcome.EnchantTable.Label"}}</label>
                  <select class="cog-field-input" data-change-action="selectOutcomeTable" data-index="{{idx}}" style="width: 100%; font-size: 11px;">
                    {{#each out.enchantTableOptions as |tOpt|}}<option value="{{tOpt.value}}" {{#if tOpt.selected}}selected{{/if}}>{{#if tOpt.group}}{{tOpt.group}}: {{/if}}{{tOpt.name}}</option>{{/each}}
                  </select>
                  <div class="cog-text-secondary" style="font-size: 11px;">{{localize "COG.Outcome.EnchantTable.Hint"}}</div>
                </td>
              </tr>
            {{/if}}
            {{#if out.isEnchantItem}}
              <tr>
                <td colspan="6" class="cog-outcome-enchantments">
                  {{> "systems/sprinter-rpg/templates/items/parts/enchantment-templates.hbs" templates=out.enchantTemplates templatesPath=out.enchantTemplatesPath}}
                </td>
              </tr>
            {{/if}}
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <div class="cog-text-secondary" style="text-align: center; font-size: 11px; padding: 6px;">
            Activated ability enabled. Click <strong>Add Effect</strong> to attach on-use effects to this piece of gear.
          </div>
        {{/if}}
      </div>
    {{else}}
      <div class="cog-text-muted cog-bg-surface" style="text-align: center; font-style: italic; font-size: 11px; padding: 6px; border: 1px dashed var(--cog-border-muted); border-radius: 3px;">
        On-use activated abilities disabled. Check "Enable Activated Ability" above to attach effects, charges, or cooldowns.
      </div>
    {{/if}}
  </div>
</details>

{{> "systems/sprinter-rpg/templates/items/parts/on-hit.hbs"}}

{{!-- ENCHANTMENTS (3.15): the ledger of what this gear was enchanted with --}}
{{> "systems/sprinter-rpg/templates/items/parts/enchantment-ledger.hbs"}}

{{!-- PERSISTENT BUFFS & DEBUFFS ON THE WIELDER (EQUIPPED); resistances and immunities are Defense rows (3.38) --}}
<details class="cog-collapsible-block" {{#if persistentEffectsPicker.hasValues}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-shield-halved"></i> PERSISTENT BUFFS & DEBUFFS (EQUIPPED)</span>
    <span class="cog-toggle-indicator {{#if persistentEffectsPicker.hasValues}}active{{/if}}">{{#if persistentEffectsPicker.hasValues}}[ACTIVE CONDITIONS]{{else}}[CLICK TO CONFIGURE PERSISTENT BUFFS/DEBUFFS]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=persistentEffectsPicker}}
    <p class="cog-pick-hint cog-text-muted"><i class="fa-solid fa-circle-info"></i> Resistances and immunities while equipped: add a Resistance or Immunity Defense row under Modifiers.</p>
  </div>
</details>

{{!-- PERSISTENT HEALING & CLEANSING AT ROUND END (EQUIPPED) --}}
<details class="cog-collapsible-block" {{#if (or system.healing.hasHealing system.healing.barsPerRound cleanseDebuffsString)}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-heart-pulse"></i> PERSISTENT HEALING & CLEANSING (COMBAT ROUND END)</span>
    <span class="cog-toggle-indicator {{#if (or system.healing.hasHealing system.healing.barsPerRound cleanseDebuffsString)}}active{{/if}}">{{#if (or system.healing.hasHealing system.healing.barsPerRound cleanseDebuffsString)}}[HEALING CONFIGURED]{{else}}[CLICK TO CONFIGURE HEALING/CLEANSING]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row" style="margin-bottom: 6px;">
      <div class="cog-field-group small" style="text-align: center;">
        <span class="cog-field-label">Enable Healing</span>
        <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;">
          <input type="checkbox" name="system.healing.hasHealing" {{#if (or system.healing.hasHealing (gt system.healing.barsPerRound 0))}}checked{{/if}} class="cog-checkbox-lg" />
        </label>
      </div>
      <div class="cog-field-group small">
        <span class="cog-field-label">Health Bars / Round</span>
        <input class="cog-field-input" type="number" name="system.healing.barsPerRound" value="{{system.healing.barsPerRound}}" placeholder="1" min="0" style="font-size: 11px;" />
      </div>
      <div class="cog-field-group" style="flex: 2;">
        <span class="cog-field-label"><i class="fa-solid fa-sparkles cog-text-success"></i> Cleanse Debuffs Each Round (Comma-Separated)</span>
        <input class="cog-field-input" type="text" name="system.healing.cleanseDebuffs" value="{{cleanseDebuffsString}}" placeholder="e.g. Bleeding, Burned" list="cog-available-debuffs-list-{{item.id}}" style="font-size: 11px;" />
      </div>
    </div>
  </div>
</details>

<div class="cog-field-group">
  <span class="cog-field-label">Notes</span>
  <textarea class="cog-field-input" name="system.notes" style="height: 80px;">{{system.notes}}</textarea>
</div>
<div class="cog-field-group" style="margin-top: 8px;">
  <span class="cog-field-label">Description</span>
  {{editor descriptionHtml target="system.description" button=true editable=editable engine="prosemirror" collaborate=false}}
</div>


{{#if availableBuffs.length}}
  <datalist id="cog-available-buffs-list-{{item.id}}">
    {{#each availableBuffs as |b|}}
      <option value="{{b.system.identifier}}">{{b.name}}</option>
    {{/each}}
  </datalist>
{{/if}}

{{#if availableDebuffs.length}}
  <datalist id="cog-available-debuffs-list-{{item.id}}">
    {{#each availableDebuffs as |d|}}
      <option value="{{d.system.identifier}}">{{d.name}}</option>
    {{/each}}
  </datalist>
{{/if}}

{{> "systems/sprinter-rpg/templates/items/parts/copy-blueprint.hbs"}}
</section>
