<header class="cog-fsim-header">
  <div class="cog-fsim-title-row">
    <h2><i class="fa-solid fa-stairs"></i> {{localize 'COG.FloorSim.Title'}}: {{actor.name}}</h2>
    {{#unless empty}}
      <span class="cog-fsim-sub">{{localize 'COG.FloorSim.Header.State' level=header.level floor=header.floorLabel}}</span>
    {{/unless}}
  </div>
  {{#unless empty}}
    <div class="cog-fsim-controls">
      <label class="cog-fsim-field">
        <span>{{localize 'COG.FloorSim.Header.Target'}}</span>
        <select data-change-action="setStartFloor">
          {{#each header.targetOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if finishes}} ({{localize 'COG.FloorSim.Header.Finishes'}}){{/if}}</option>
          {{/each}}
        </select>
      </label>
      <ol class="cog-fsim-chips" aria-label="{{localize 'COG.FloorSim.Header.Run'}}">
        {{#each header.chips}}
          <li class="cog-fsim-chip{{#if done}} done{{/if}}{{#if current}} current{{/if}}">{{#if done}}<i class="fa-solid fa-check"></i> {{/if}}{{label}}</li>
        {{/each}}
      </ol>
      <label class="cog-fsim-field">
        <span>{{localize 'COG.FloorSim.Header.RollMode'}}</span>
        <select data-change-action="setRollMode">
          {{#each rollModes}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>
          {{/each}}
        </select>
      </label>
    </div>
  {{/unless}}
</header>
