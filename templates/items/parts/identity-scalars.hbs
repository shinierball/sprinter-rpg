{{!--
  The race and class single-value editors: senses, movement and stat caps as number inputs and a checkbox,
  and the `requires` tag query. Parameter: identityRows = buildIdentityRowsContext(...)
  (src/sheets/item/context-identity-rows.mjs). A blank number stores nothing. Inputs are named `system.<group>.<key>` by
  the context (a window renames them); the `requires` query is an action delegate without a `name`.
--}}
<div class="cog-modifier-block cog-identity-scalars">
  {{#each identityRows.scalars as |g|}}
    <div class="cog-modifier-body" data-identity-group="{{g.group}}">
      <span class="cog-field-label"><strong>{{localize g.titleKey}}</strong> <span class="cog-modifier-hint">{{localize g.hintKey}}</span></span>
      <div class="cog-field-row">
        {{#each g.fields as |f|}}
          <div class="cog-field-group small">
            <span class="cog-field-label">{{localize f.labelKey}}</span>
            {{#if f.isCheckbox}}
              <input type="checkbox" name="{{f.name}}" data-row-field="{{f.key}}" {{#if f.checked}}checked{{/if}} />
            {{else}}
              <input class="cog-field-input" type="number" name="{{f.name}}" data-row-field="{{f.key}}" value="{{f.value}}" step="{{f.step}}"{{#if f.hasMin}} min="{{f.min}}"{{/if}} />
            {{/if}}
          </div>
        {{/each}}
      </div>
    </div>
  {{/each}}
  <div class="cog-modifier-body" data-identity-group="requires">
    <span class="cog-field-label"><strong>{{localize "COG.Rows.Identity.requires.Title"}}</strong> <span class="cog-modifier-hint">{{localize "COG.Rows.Identity.requires.Hint"}}</span></span>
    {{> "systems/sprinter-rpg/templates/items/parts/tag-query-editor.hbs" query=identityRows.requires.query tagOptions=identityRows.requires.tagOptions}}
  </div>
</div>
