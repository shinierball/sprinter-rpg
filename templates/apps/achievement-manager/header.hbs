<header class="cog-manager-header cog-bg-window" style="border-bottom: 3px solid var(--cog-accent); padding: 10px 14px; display: flex; justify-content: space-between; align-items: center;">
  <div style="display: flex; align-items: center; gap: 10px;">
    <i class="fa-solid fa-trophy cog-text-gold" style="font-size: 24px;"></i>
    <div>
      <h2 class="cog-text-strong" style="margin: 0; font-family: 'Oswald', sans-serif; font-size: 18px; text-transform: uppercase; letter-spacing: 1px;">
        SPRINTER RPG — ACHIEVEMENT TROPHY ROOM
      </h2>
      <span class="cog-text-secondary" style="font-size: 11px;">Dungeon AI Library &amp; Party Trophy Collection</span>
    </div>
  </div>

  {{!-- Crawler Selector for Granting --}}
  <div style="display: flex; align-items: center; gap: 8px;">
    <label class="cog-text-strong" style="font-size: 11px; text-transform: uppercase; font-weight: bold; margin: 0;">Target Crawler:</label>
    <select name="targetCrawler" data-change-action="setCrawler" class="cog-crawler-select cog-bg-surface-muted cog-text-strong" style="border: 1px solid var(--cog-accent); border-radius: 4px; padding: 3px 8px; font-family: 'Oswald', sans-serif; font-size: 12px;">
      <option value="">-- Select a crawler --</option>
      {{#each crawlers}}
        <option value="{{this.id}}" {{#if (eq this.id ../currentActor.id)}}selected{{/if}}>
          {{this.name}} (Floor: {{this.system.details.floor}})
        </option>
      {{/each}}
    </select>
  </div>
</header>
