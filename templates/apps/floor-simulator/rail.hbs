<nav class="cog-fsim-rail" aria-label="{{localize 'COG.FloorSim.Rail.Label'}}">
  {{#unless empty}}
    <ol class="cog-fsim-steps">
      {{#each steps}}
        <li>
          <button type="button" class="cog-fsim-step {{status}}{{#if active}} active{{/if}}{{#if stage}} stage{{/if}}{{#if nested}} nested{{/if}}" data-action="goStep" data-step="{{id}}">
            <span class="cog-fsim-step-mark">{{#if (eq status 'done')}}<i class="fa-solid fa-check"></i>{{else}}<i class="fa-regular fa-circle"></i>{{/if}}</span>
            <span class="cog-fsim-step-label">{{localize labelKey}}</span>
            {{#if breaks}}<span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}
            {{#if openDice}}<span class="cog-fsim-dice-count" title="{{localize 'COG.FloorSim.Rail.OpenDice'}}">{{openDice}}</span>{{/if}}
          </button>
        </li>
      {{/each}}
    </ol>
  {{/unless}}
</nav>
