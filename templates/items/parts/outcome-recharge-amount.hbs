{{!-- A recharge outcome row's amount (`amount`: blank refills fully). Context: out, idx. --}}
<input class="cog-field-input" type="number" min="1" name="system.outcomes.{{idx}}.amount" value="{{out.rechargeAmount}}" placeholder="{{localize "COG.Outcome.Recharge.AmountPlaceholder"}}" data-tooltip="{{localize "COG.Outcome.Recharge.AmountHint"}}" style="width: 100%; font-size: 11px;" />
