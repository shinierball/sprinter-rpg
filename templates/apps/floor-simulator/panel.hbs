{{#*inline "die"}}
<span class="cog-fsim-die{{#if open}} open{{/if}}">
  <input type="number" class="cog-fsim-die-input" data-change-action="setField" data-type="int" data-path="{{path}}" value="{{value}}" placeholder="{{formula}}" aria-label="{{formula}}" />
  <button type="button" class="cog-fsim-roll" data-action="rollDie" data-path="{{path}}" data-formula="{{formula}}" title="{{localize 'COG.FloorSim.Roll'}} {{formula}}"><i class="fa-solid fa-dice-d20"></i> {{formula}}</button>
  {{#if rolled}}<i class="fa-solid fa-dice cog-fsim-rolled-mark" title="{{localize 'COG.FloorSim.RolledInApp'}}"></i>{{/if}}
</span>
{{/inline}}
{{#*inline "rollbtn"}}
<button type="button" class="cog-fsim-roll" data-action="rollDie" data-path="{{path}}" data-formula="{{formula}}" title="{{localize 'COG.FloorSim.Roll'}} {{formula}}"><i class="fa-solid fa-dice-d20"></i> {{formula}}</button>
{{/inline}}
{{#*inline "change"}}
<span class="cog-fsim-change">{{before}} <i class="fa-solid fa-arrow-right"></i> <strong>{{after}}</strong>{{#if capped}} <span class="cog-fsim-badge cap">{{localize 'COG.FloorSim.Capped'}}{{#if overflow}} (+{{overflow}}){{/if}}</span>{{/if}}{{#if ruleBreak}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}{{#if note}} <em>{{note}}</em>{{/if}}</span>
{{/inline}}
<section class="cog-fsim-panel">
{{#with panel as |p|}}

  {{#if p.isLevel}}
    <h3>{{localize 'COG.FloorSim.Step.level'}}</h3>
    <p class="cog-fsim-big">{{localize 'COG.FloorSim.Level.Summary' from=p.from to=p.to levels=p.levelsGained points=p.pointsGained}}</p>
    <p class="cog-fsim-note">{{localize 'COG.FloorSim.Level.NoSkip'}}</p>
  {{/if}}

  {{#if p.isPrimaryBoost}}
    <h3>{{localize 'COG.FloorSim.Step.primaryBoost'}}</h3>
    <p class="cog-fsim-note">{{localize 'COG.FloorSim.Primary.Note' formula=p.formula}}</p>
    <label class="cog-fsim-field">
      <span>{{localize 'COG.FloorSim.Primary.Item'}}</span>
      <select data-change-action="setPrimary">
        <option value="" {{#unless p.hasItem}}selected{{/unless}}></option>
        {{#each p.items}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}} ({{rank}})</option>{{/each}}
      </select>
    </label>
    {{#if p.hasItem}}
      <div class="cog-fsim-line">{{> die p.die}} {{#if p.entry}}{{> change p.entry}}{{/if}}</div>
    {{/if}}
  {{/if}}

  {{#if p.isOtherBoosts}}
    <h3>{{localize 'COG.FloorSim.Step.otherBoosts'}}</h3>
    <p class="cog-fsim-note">{{localize 'COG.FloorSim.Others.Note'}}</p>
    <p class="cog-fsim-counter{{#if p.counter.over}} over{{/if}}">{{localize 'COG.FloorSim.Counter' count=p.counter.count max=p.counter.max}}{{#if p.counter.over}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}</p>
    <ul class="cog-fsim-picklist">
      {{#each p.rows}}
        <li class="cog-fsim-pickrow{{#if checked}} checked{{/if}}">
          <label><input type="checkbox" data-change-action="togglePick" data-step="{{p.stepId}}" data-item="{{id}}" {{#if checked}}checked{{/if}} /> {{name}}</label>
          <span class="cog-fsim-rank">{{localize 'COG.FloorSim.Rank'}} {{rank}}</span>
          {{#if checked}}{{> die die}} {{#if entry}}{{> change entry}}{{/if}}{{/if}}
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if p.isChosenSkills}}
    <h3>{{localize 'COG.FloorSim.Step.chosenSkills'}}</h3>
    <p class="cog-fsim-note">{{localize 'COG.FloorSim.Chosen.Note'}}</p>
    <p class="cog-fsim-counter{{#if p.counter.over}} over{{/if}}">{{localize 'COG.FloorSim.Counter' count=p.counter.count max=p.counter.max}}{{#if p.counter.over}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}</p>
    <ul class="cog-fsim-picklist">
      {{#each p.rows}}
        <li class="cog-fsim-pickrow{{#if checked}} checked{{/if}}">
          <label><input type="checkbox" data-change-action="togglePick" data-step="{{p.stepId}}" data-item="{{id}}" {{#if checked}}checked{{/if}} /> {{name}}</label>
          <span class="cog-fsim-rank">{{localize 'COG.FloorSim.Rank'}} {{rank}} &middot; {{formula}}</span>
          {{#if (eq kind 'spell')}}<span class="cog-fsim-badge spell">[SPELL]</span>{{/if}}
          {{#if rankCeiling}}<span class="cog-fsim-badge cap">{{localize 'COG.FloorSim.RankMax' rank=rankCeiling}}</span>{{/if}}
          {{#if checked}}{{> die die}} {{#if entry}}{{> change entry}}{{/if}}{{/if}}
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if p.isExperiences}}
    <h3>{{localize 'COG.FloorSim.Step.experiences'}}</h3>
    {{#if p.fixedMode}}
      <p class="cog-fsim-note">{{localize 'COG.FloorSim.Exp.CustomOnly'}}</p>
    {{else}}
      <div class="cog-fsim-modes" role="group" aria-label="{{localize 'COG.FloorSim.Exp.ModeLabel'}}">
        {{#each p.modes}}<button type="button" class="cog-fsim-mode{{#if active}} active{{/if}}" data-action="setMode" data-step="{{p.stepId}}" data-mode="{{value}}">{{localize labelKey}}</button>{{/each}}
      </div>
    {{/if}}
    {{#each p.slots}}
      <div class="cog-fsim-slot">
        <h4>{{localize 'COG.FloorSim.Exp.Slot' n=number}}{{#if tableName}} &middot; {{tableName}}{{/if}}</h4>
        <div class="cog-fsim-line">
          {{#if (eq p.mode 'custom')}}
            <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Exp.Table'}}</span>
              <select data-change-action="setField" data-type="text" data-path="{{p.stepId}}.picks.{{index}}.tableKey">
                {{#each tableOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#unless available}}{{#if value}}disabled{{/if}}{{/unless}}>{{label}}</option>{{/each}}
              </select>
            </label>
          {{else}}
            {{#if indexDie}}
              <span class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Exp.IndexRow'}}</span> {{> die indexDie}}</span>
            {{else}}
              <span class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Exp.IndexRow'}}</span> <strong>{{indexRow}}</strong></span>
            {{/if}}
          {{/if}}
          {{#if hasTable}}
            <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Exp.Row'}}</span>
              <select data-change-action="setField" data-type="int" data-path="{{p.stepId}}.picks.{{index}}.row">
                {{#each rowOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            {{> rollbtn rowDie}}
            <span class="cog-fsim-marker {{rowMarker}}">{{#if (eq rowMarker 'rolled')}}{{localize 'COG.FloorSim.Marker.Rolled'}}{{/if}}{{#if (eq rowMarker 'chosen')}}{{localize 'COG.FloorSim.Marker.Chosen'}}{{/if}}{{#if (eq rowMarker 'open')}}{{localize 'COG.FloorSim.Marker.Open'}}{{/if}}</span>
          {{/if}}
        </div>
        {{#if hasRow}}<p class="cog-fsim-narrative">{{narrative}}</p>{{/if}}
        {{#if hasRow}}
          {{#each skills}}
            <div class="cog-fsim-skill">
              <div class="cog-fsim-skill-head">
                <span class="cog-fsim-badge">{{formula}}</span>
                {{#if (eq index 0)}}{{#if ../canSwap}}<button type="button" class="cog-fsim-link" data-action="swapFormulas" data-step="{{p.stepId}}" data-slot="{{../index}}" title="{{localize 'COG.FloorSim.Exp.Swap'}}"><i class="fa-solid fa-right-left"></i></button>{{/if}}{{/if}}
              </div>
              <div class="cog-fsim-chiprow">
                {{#each chips}}
                  <button type="button" class="cog-fsim-optchip{{#if active}} active{{/if}}" data-action="pickOption" data-step="{{p.stepId}}" data-slot="{{../../index}}" data-skill="{{../index}}" data-option="{{index}}">
                    {{#if isCustom}}<i class="fa-solid fa-pen"></i> {{localize 'COG.FloorSim.Exp.Custom'}}{{else}}{{#if isChoice}}<i class="fa-solid fa-list"></i> {{localize 'COG.FloorSim.Exp.Choice'}}{{else}}{{label}}{{/if}}{{/if}}
                    {{#if needsImport}}<span class="cog-fsim-badge">{{localize 'COG.FloorSim.Exp.NeedsImport'}}</span>{{/if}}
                    {{#if ceiling}}<span class="cog-fsim-badge cap">{{localize 'COG.FloorSim.RankMax' rank=ceiling}}</span>{{/if}}
                  </button>
                {{/each}}
              </div>
              {{#if choice}}
                <select data-change-action="setField" data-type="text" data-path="{{choice.path}}">
                  {{#each choice.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              {{/if}}
              {{#if custom}}
                <input type="text" data-change-action="setField" data-type="text" data-path="{{custom.namePath}}" value="{{custom.name}}" placeholder="{{localize 'COG.FloorSim.Exp.CustomName'}}" />
                <select data-change-action="setField" data-type="text" data-path="{{custom.kindPath}}">
                  {{#each custom.kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
                </select>
              {{/if}}
              {{#if die}}<div class="cog-fsim-line">{{> die die}}</div>{{/if}}
            </div>
          {{/each}}
        {{/if}}
      </div>
    {{/each}}
  {{/if}}

  {{#if p.isLoot}}
    <h3>{{localize 'COG.FloorSim.Step.loot'}}{{#if p.tableName}} &middot; {{p.tableName}}{{/if}}</h3>
    {{#if p.reuse}}
      <p class="cog-fsim-note">{{localize 'COG.FloorSim.Loot.Reused' row=p.reuse.row floor=p.reuse.floor}}</p>
    {{else}}
      <div class="cog-fsim-line">
        <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Exp.Row'}}</span>
          <select data-change-action="setField" data-type="int" data-path="{{p.rowPath}}">
            {{#each p.rowOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        {{> rollbtn p.rowDie}}
        <span class="cog-fsim-marker {{p.rowMarker}}">{{#if (eq p.rowMarker 'rolled')}}{{localize 'COG.FloorSim.Marker.Rolled'}}{{/if}}{{#if (eq p.rowMarker 'chosen')}}{{localize 'COG.FloorSim.Marker.Chosen'}}{{/if}}{{#if (eq p.rowMarker 'open')}}{{localize 'COG.FloorSim.Marker.Open'}}{{/if}}</span>
      </div>
    {{/if}}
    {{#each p.cards}}
      <div class="cog-fsim-card tier-{{tier}}">
        <div class="cog-fsim-card-head"><span class="cog-fsim-badge tier">{{tier}}</span> <strong>{{slot}}</strong></div>
        <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Loot.TakeLabel'}}</span>
          <select data-change-action="setField" data-type="text" data-path="{{takePath}}">
            {{#each takeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}
          </select>
        </label>
        {{#if takeLoot}}
          <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Loot.Option'}}</span>
            <select data-change-action="setField" data-type="text" data-path="{{optionPath}}">
              {{#each optionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          {{#each params}}
            <label class="cog-fsim-field"><span>{{key}}</span>
              {{#if (eq kind 'select')}}
                <select data-change-action="setField" data-type="text" data-path="{{path}}">
                  {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              {{else}}
                <input type="text" data-change-action="setField" data-type="text" data-path="{{path}}" value="{{value}}" />
              {{/if}}
            </label>
          {{/each}}
          {{#if braceletRace}}
            <div class="cog-fsim-line">
              <span>{{localize 'COG.FloorSim.Loot.BraceletRace'}}</span> {{> rollbtn braceletRace.die}}
              <span class="cog-fsim-marker {{braceletRace.marker}}">{{#if (eq braceletRace.marker 'rolled')}}{{localize 'COG.FloorSim.Marker.Rolled'}}{{/if}}{{#if (eq braceletRace.marker 'chosen')}}{{localize 'COG.FloorSim.Marker.Chosen'}}{{/if}}{{#if (eq braceletRace.marker 'open')}}{{localize 'COG.FloorSim.Marker.Open'}}{{/if}}</span>
            </div>
            {{#if braceletRace.name}}<p class="cog-fsim-narrative">{{braceletRace.name}}{{#unless braceletRace.installed}} ({{localize 'COG.FloorSim.Loot.BraceletRaceMissing'}}){{/unless}}{{#if braceletRace.narrative}}: {{braceletRace.narrative}}{{/if}}</p>{{/if}}
          {{/if}}
          {{#if scrollRoll}}<div class="cog-fsim-line"><span>{{localize 'COG.FloorSim.Loot.ScrollSpell'}}</span> {{> rollbtn scrollRoll}}</div>{{/if}}
          {{#if scroll}}
            <div class="cog-fsim-line">
              <span>{{localize 'COG.FloorSim.Loot.UpgradeRow'}}</span>
              {{> die scroll.die}}
            </div>
            {{#if scroll.narrative}}<p class="cog-fsim-narrative">{{scroll.narrative}}</p>{{/if}}
            {{#if scroll.optionOptions.length}}
              <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Loot.UpgradeTrigger'}}</span>
                <select data-change-action="setField" data-type="int" data-path="{{scroll.optionPath}}">
                  {{#each scroll.optionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            {{/if}}
            <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Loot.UpgradeName'}}</span>
              <input type="text" data-change-action="setField" data-type="text" data-path="{{scroll.namePath}}" value="{{scroll.name}}" />
            </label>
          {{/if}}
        {{/if}}
        {{#if takeSpells}}
          <div class="cog-fsim-line">
            <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Loot.Variant'}}</span>
              <select data-change-action="setField" data-type="text" data-path="{{variantPath}}">
                {{#each variants}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if potions}} + {{potions}} {{localize 'COG.FloorSim.Loot.Potions'}}{{/if}}</option>{{/each}}
              </select>
            </label>
          </div>
          {{#each spellPicks}}
            <div class="cog-fsim-spellpick">
              <div class="cog-fsim-line">
                <span class="cog-fsim-badge spell">[SPELL]</span>
                {{#if rowDie}}
                  <select data-change-action="setField" data-type="int" data-path="{{rowDie.path}}">
                    {{#each rowOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                  {{> rollbtn rowDie}}
                {{/if}}
                {{#if name}}<strong>{{name}}</strong>{{/if}}
                {{#if tome}}<span class="cog-fsim-badge tome">{{localize 'COG.FloorSim.Loot.Tome'}}</span>{{/if}}
              </div>
              {{#if resolved}}
                <div class="cog-fsim-line">
                  {{#if duplicate}}
                    <span>{{localize 'COG.FloorSim.Loot.Duplicate'}}</span> {{> die dupDie}}
                  {{else}}
                    <span>{{localize 'COG.FloorSim.Loot.Rank'}}</span> {{> die rankDie}}
                  {{/if}}
                </div>
              {{/if}}
              {{#if substitute}}
                <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.Loot.Substitute'}}</span>
                  <select data-change-action="setField" data-type="text" data-path="{{substitute.path}}">
                    {{#each substitute.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
              {{/if}}
            </div>
          {{/each}}
        {{/if}}
        {{#if entry}}<p class="cog-fsim-note">{{entry.label}}{{#if entry.note}} &middot; {{entry.note}}{{/if}}{{#if entry.ruleBreak}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}</p>{{/if}}
      </div>
    {{/each}}
    {{#unless p.hasCards}}<p class="cog-fsim-note">{{localize 'COG.FloorSim.Loot.PickRow'}}</p>{{/unless}}
  {{/if}}

  {{#if p.isStats}}
    <h3>{{localize 'COG.FloorSim.Step.stats'}}</h3>
    <p class="cog-fsim-big{{#if p.over}} over{{/if}}">{{localize 'COG.FloorSim.Stats.Pool' pool=p.pool left=p.left}}{{#if p.over}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}</p>
    <p class="cog-fsim-note">{{localize 'COG.FloorSim.Stats.Note'}}</p>
    <table class="cog-fsim-table">
      <tbody>
        {{#each p.rows}}
          <tr>
            <th scope="row">{{upper key}}</th>
            <td>{{unenhanced}} <i class="fa-solid fa-arrow-right"></i> <strong>{{afterUnenhanced}}</strong></td>
            <td class="cog-fsim-muted">{{localize 'COG.FloorSim.Stats.Enhanced' from=enhanced to=afterEnhanced}}</td>
            <td class="cog-fsim-stepper">
              <button type="button" data-action="adjustStat" data-step="{{p.stepId}}" data-key="{{key}}" data-delta="-1" aria-label="-1"><i class="fa-solid fa-minus"></i></button>
              <span class="cog-fsim-stepper-value">+{{added}}</span>
              <button type="button" data-action="adjustStat" data-step="{{p.stepId}}" data-key="{{key}}" data-delta="1" aria-label="+1"><i class="fa-solid fa-plus"></i></button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    {{#if p.leftover}}<p class="cog-fsim-note">{{localize 'COG.FloorSim.Stats.Leftover' left=p.leftover}}</p>{{/if}}
  {{/if}}

  {{#if p.isAiFavor}}
    <h3>{{localize 'COG.FloorSim.Step.aiFavor'}}</h3>
    <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.AiFavor.Rating'}}</span>
      <select data-change-action="setField" data-type="int" data-path="{{p.ratingPath}}">
        {{#each p.ratings}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <p class="cog-fsim-note">{{localize 'COG.FloorSim.AiFavor.Note' rating=p.defaultRating}}</p>
    <div class="cog-fsim-line"><span>{{localize 'COG.FloorSim.AiFavor.Base'}}</span> {{> die p.baseDie}}</div>
    {{#if p.bonusDie}}<div class="cog-fsim-line"><span>{{localize 'COG.FloorSim.AiFavor.Bonus'}}</span> {{> die p.bonusDie}}</div>{{/if}}
    {{#if p.entry}}{{> change p.entry}}{{/if}}
  {{/if}}

  {{#if p.isPopularity}}
    <h3>{{localize 'COG.FloorSim.Step.popularity'}}</h3>
    <p class="cog-fsim-big">{{localize 'COG.FloorSim.Popularity.Summary' mod=p.chaMod multiplier=p.multiplier value=p.value}}</p>
    {{#if p.entry}}{{> change p.entry}}{{/if}}
  {{/if}}

  {{#if p.isRaceClass}}
    <h3>{{localize 'COG.FloorSim.Step.raceClass'}}</h3>
    {{#if p.emptyListsNote}}<p class="cog-fsim-note cog-ai-hidden-note">{{p.emptyListsNote}}</p>{{/if}}
    <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.RaceClass.Race'}}</span>
      <select data-change-action="setField" data-type="text" data-path="{{p.racePath}}">
        <option value="">{{localize 'COG.FloorSim.RaceClass.Later'}}</option>
        {{#each p.raceOptions as |group|}}<optgroup label="{{group.label}}">{{#each group.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
      </select>
    </label>
    <label class="cog-fsim-field"><span>{{localize 'COG.FloorSim.RaceClass.Class'}}</span>
      <select data-change-action="setField" data-type="text" data-path="{{p.classPath}}">
        <option value="">{{localize 'COG.FloorSim.RaceClass.Later'}}</option>
        {{#each p.classOptions as |group|}}<optgroup label="{{group.label}}">{{#each group.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
      </select>
    </label>
    {{#if p.laterChosen}}<p class="cog-fsim-note">{{localize 'COG.FloorSim.RaceClass.LaterNote'}}</p>{{/if}}
    {{#each p.kinds as |k|}}
      <div class="cog-fsim-card">
        <div class="cog-fsim-card-head"><span class="cog-fsim-badge">{{localize k.labelKey}}</span> <strong>{{k.name}}</strong> {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=k.sourceBadge}}</div>
        {{#unless k.hasFields}}<p class="cog-fsim-note">{{localize 'COG.CrawlerCreator.RaceClass.NoFields'}}</p>{{/unless}}
        {{#each k.choices}}
          <label class="cog-fsim-field"><span>{{label}}{{#if rank}} (+{{rank}}){{/if}}</span>
            <select data-change-action="setField" data-type="text" data-path="{{path}}">
              {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
        {{/each}}
        {{#each k.pools as |pool|}}
          <p class="cog-fsim-counter{{#if pool.over}} over{{/if}}">{{pool.line}}{{#if pool.over}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}</p>
          <div class="cog-fsim-line">
            {{#each pool.rows}}
              <label class="cog-fsim-field"><span>{{upper stat}}</span>
                <input type="number" class="cog-fsim-die-input" min="0" data-change-action="setPoolStat" data-type="int" data-kind="{{k.kind}}" data-grant="{{pool.grantIndex}}" data-stat="{{stat}}" value="{{value}}" />
              </label>
            {{/each}}
          </div>
        {{/each}}
        {{#if k.startingItems.length}}
          <h4>{{localize 'COG.CrawlerCreator.RaceClass.StartingItems'}}</h4>
          <ul class="cog-fsim-picklist">
            {{#each k.startingItems}}
              <li class="cog-fsim-pickrow{{#if accepted}} checked{{/if}}"><label><input type="checkbox" data-change-action="toggleStartingItem" data-kind="{{k.kind}}" data-index="{{index}}" {{#if accepted}}checked{{/if}} /> {{label}}</label></li>
            {{/each}}
          </ul>
        {{/if}}
        {{#each k.startingChoices}}
          <label class="cog-fsim-field"><span>{{label}}</span>
            <select data-change-action="setField" data-type="text" data-path="{{path}}">
              {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
        {{/each}}
      </div>
    {{/each}}
  {{/if}}

  {{#if p.isReview}}
    <h3>{{localize 'COG.FloorSim.Step.review'}}</h3>
    {{#if p.openDice}}<p class="cog-fsim-note">{{localize 'COG.FloorSim.Review.OpenDice' count=p.openDice}}</p>{{/if}}
    {{#if p.ruleBreaks.length}}
      <div class="cog-fsim-breaks">
        <strong><span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span> {{localize 'COG.FloorSim.Review.Breaks'}}</strong>
        <ul>{{#each p.ruleBreaks}}<li>{{reason}}</li>{{/each}}</ul>
      </div>
    {{/if}}
    {{#each p.sections}}
      <div class="cog-fsim-log">
        <h4>{{#if floorLabel}}{{floorLabel}} &middot; {{/if}}{{localize labelKey}}</h4>
        <ul>
          {{#each entries}}
            <li><strong>{{label}}</strong> {{#if (or before after)}}{{> change this}}{{/if}} <span class="cog-fsim-muted">{{origin}}</span>{{#if pendingDie}} <span class="cog-fsim-badge cap">{{localize 'COG.FloorSim.Marker.Open'}}</span>{{/if}}{{#if ruleBreak}} <span class="cog-fsim-badge break">{{localize 'COG.FloorSim.RuleBreakBadge'}}</span>{{/if}}
              {{#if narrative}}<div class="cog-fsim-narrative">{{narrative}}</div>{{/if}}</li>
          {{/each}}
        </ul>
      </div>
    {{/each}}
    {{#if p.warnings.length}}<ul class="cog-fsim-warnings">{{#each p.warnings}}<li>{{message}}</li>{{/each}}</ul>{{/if}}
  {{/if}}

{{/with}}
</section>
