<div class="cog-manager-body cog-bg-surface-muted" style="flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px;">
  {{#each spells as |spell|}}
    <div class="cog-spell-card-row cog-spell-card-draggable cog-bg-surface-muted cog-text" data-spell-name="{{spell.name}}" data-spell-id="{{spell.id}}" draggable="true" style="border: 1px solid var(--cog-panel-border); border-left: 4px solid {{#if spell.isHeal}}var(--cog-success){{else if spell.isAttack}}var(--cog-accent){{else}}var(--cog-info){{/if}}; border-radius: 4px; padding: 8px 10px; display: flex; flex-direction: column; gap: 4px;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <img class="cog-bg-icon-box" src="{{spell.img}}" style="width: 32px; height: 32px; border: 1px solid var(--cog-ink); border-radius: 3px; object-fit: contain;" />
          <div>
            <span class="cog-text-strong" style="font-size: 14px; font-weight: bold;">{{spell.name}}</span>
            {{> "systems/sprinter-rpg/templates/shared/source-badge.hbs" badge=spell.sourceBadge}}
            <div style="display: flex; gap: 4px; align-items: center; margin-top: 2px;">
              <span class="cog-badge cog-dark cog-bg-header-fill cog-text-on-fill" style="font-size: 9px; padding: 1px 4px;">{{spell.roleLabel}}</span>
              <span class="cog-badge cog-bg-info-fill cog-text-on-fill" style="font-size: 9px; padding: 1px 4px;">{{spell.system.manaCost}} MP</span>
              <span class="cog-badge cog-bg-magic-fill cog-text-on-fill" style="font-size: 9px; padding: 1px 4px;">{{spell.statUpper}}</span>
              {{#if spell.system.damageType}}
                <span class="cog-badge cog-bg-warning-fill cog-text-on-fill" style="font-size: 9px; padding: 1px 4px;">{{spell.system.damageType}}</span>
              {{/if}}
            </div>
          </div>
        </div>

        <div style="display: flex; gap: 6px; align-items: center;">
          <button type="button" data-action="castSpell" class="btn-cast-spell cog-btn cog-dark cog-bg-header-fill cog-text-on-fill" data-spell-id="{{spell.id}}" title="Cast / Preview Spell" style="font-size: 11px; padding: 4px 8px; border: 1px solid var(--cog-ink); border-radius: 3px; cursor: pointer;">
            <i class="fa-solid fa-comment-dots"></i> Preview
          </button>
          {{#if ../actor}}
            {{#if spell.isKnown}}
              <span class="cog-badge cog-bg-success-fill cog-text-on-fill" style="font-size: 11px; padding: 4px 8px;">
                <i class="fa-solid fa-check"></i> Known
              </span>
            {{else}}
              <button type="button" data-action="learnSpell" class="btn-learn-spell cog-btn cog-bg-accent-fill cog-text-on-fill" data-spell-id="{{spell.id}}" style="font-size: 11px; padding: 4px 8px; border: 1px solid var(--cog-ink); border-radius: 3px; font-weight: bold; cursor: pointer;">
                <i class="fa-solid fa-plus"></i> Learn
              </button>
            {{/if}}
          {{/if}}
        </div>
      </div>

      {{#if spell.system.quote}}
        <div class="cog-text-gold" style="font-style: italic; font-size: 11px; opacity: 0.9; margin-top: 2px;">
          “{{spell.system.quote}}”
        </div>
      {{/if}}

      <div class="cog-text-secondary" style="font-size: 11px; line-height: 1.3;">
        {{#if spell.system.damageText}}
          <span class="cog-text-danger" style="font-weight: bold;">Damage/Effect:</span> {{spell.system.damageText}} •
        {{/if}}
        <span><strong>Range:</strong> {{spell.system.range}}</span> •
        <span><strong>Duration:</strong> {{spell.system.duration}}</span>
      </div>

      {{#if spell.system.descriptionText}}
        <div class="cog-text-secondary cog-bg-surface" style="font-size: 11px; line-height: 1.3; padding: 4px 6px; border-radius: 2px; margin-top: 2px;">
          {{spell.system.descriptionText}}
        </div>
      {{/if}}
    </div>
  {{else}}
    <div class="cog-text-secondary" style="text-align: center; padding: 40px; font-size: 14px;">
      No spells found matching the search criteria.
    </div>
  {{/each}}
</div>
