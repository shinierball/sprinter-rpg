<div class="cog-mercenary-guild-app cog-bg-window cog-text cog-guild-header" style="font-family: 'Oswald', sans-serif;">
  <header class="cog-bg-window" style="border-bottom: 2px solid var(--cog-accent); padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; gap: 14px;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <div class="cog-bg-accent-fill cog-text-on-fill" style="width: 44px; height: 44px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.5);">
        <i class="fa-solid fa-users-gear"></i>
      </div>
      <div>
        <h2 class="cog-text-strong" style="margin: 0; font-size: 18px; text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">
          Mercenary Guild &amp; Freelance Retainers
        </h2>
        <div class="cog-text-secondary" style="font-size: 11px;">
          Certified Dungeon Retainers &bull; Floor-Ready Combatants &bull; Daily Contracts
        </div>
      </div>
    </div>

    {{!-- Hiring Crawler Selector & Party Fund --}}
    <div class="cog-bg-surface" style="display: flex; align-items: center; gap: 10px; border: 1px solid var(--cog-panel-border); padding: 6px 12px; border-radius: 6px;">
      <span class="cog-text-secondary" style="font-size: 11px; text-transform: uppercase; font-weight: bold;">Hiring Crawler:</span>
      <select name="hiringCrawler" data-change-action="setCrawler" class="guild-crawler-selector cog-bg-window cog-text-strong" style="border: 1px solid var(--cog-panel-border); padding: 4px 8px; border-radius: 3px; font-family: 'Oswald', sans-serif; font-size: 12px; font-weight: bold;">
        <option value="">-- Select a crawler --</option>
        {{#each crawlers as |c|}}
          <option value="{{c.id}}" {{#if c.selected}}selected{{/if}}>{{c.name}} ({{c.gold}} Gold)</option>
        {{/each}}
      </select>
      {{#if currentCrawler}}
        <div class="cog-text-warning" style="font-size: 13px; font-weight: bold; display: flex; align-items: center; gap: 4px;">
          <i class="fa-solid fa-coins"></i> {{currentCrawler.gold}} GP
        </div>
      {{/if}}
    </div>
  </header>

</div>
