{{!-- Shared "On Hit" block (attack, gear, skill, spell): applied to the TARGET of a damaging hit. Context: onHit (context-on-hit.mjs). --}}
<details class="cog-collapsible-block" {{#if onHit.configured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-droplet"></i> {{localize "COG.AbilitySheet.OnHit.Title"}}</span>
    <span class="cog-toggle-indicator {{#if onHit.configured}}active{{/if}}">{{#if onHit.configured}}{{localize "COG.AbilitySheet.OnHit.Configured"}}{{else}}{{localize "COG.AbilitySheet.OnHit.Configure"}}{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.AbilitySheet.OnHit.MinRank"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.debuffMinRank" value="{{onHit.debuffMinRank}}" placeholder="0" min="0" style="font-size: 11px;" />
      </div>
    </div>
    {{> "systems/sprinter-rpg/templates/items/parts/pick-list.hbs" picker=onHit.debuffPicker.picker}}
    <div class="cog-field-row">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.OnHitRiders.Degree"}}</span>
        <select class="cog-field-input" name="system.onHit.evadeFail.degree" style="font-size: 11px;">
          {{#each onHit.debuffPicker.degreeOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.OnHitRiders.MinSlots"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.slotLoss.minSlotsLost" value="{{onHit.debuffPicker.minSlotsLost}}" placeholder="1" min="1" style="font-size: 11px;" />
      </div>
    </div>
    <div class="cog-field-row">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.OnHitRiders.ModeHit"}}</span>
        <select class="cog-field-input" name="system.onHit.debuffMode" style="font-size: 11px;">
          {{#each onHit.debuffPicker.hitModeOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.OnHitRiders.ModeEvade"}}</span>
        <select class="cog-field-input" name="system.onHit.evadeFail.mode" style="font-size: 11px;">
          {{#each onHit.debuffPicker.evadeModeOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.OnHitRiders.ModeSlot"}}</span>
        <select class="cog-field-input" name="system.onHit.slotLoss.mode" style="font-size: 11px;">
          {{#each onHit.debuffPicker.slotModeOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </div>
    </div>
    <div class="cog-text-muted" style="font-size: 11px; padding-bottom: 4px;">{{localize "COG.OnHitRiders.Hint"}}</div>
    <div class="cog-field-row">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label"><i class="fa-solid fa-heart-pulse cog-text-accent"></i> {{localize "COG.AbilitySheet.OnHit.LifeDrain"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.lifesteal.heal" value="{{onHit.lifesteal.heal}}" placeholder="0" min="0" style="font-size: 11px;" />
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.AbilitySheet.OnHit.LifeDrainMinSlots"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.lifesteal.minSlotsLost" value="{{onHit.lifesteal.minSlotsLost}}" placeholder="1" min="1" style="font-size: 11px;" />
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.AbilitySheet.OnHit.LifeDrainMinRank"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.lifesteal.minRank" value="{{onHit.lifesteal.minRank}}" placeholder="0" min="0" style="font-size: 11px;" />
      </div>
    </div>
    <div class="cog-field-row">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label"><i class="fa-solid fa-wand-sparkles cog-text-accent"></i> {{localize "COG.AbilitySheet.OnHit.Dispel"}}</span>
        <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; font-weight: bold; cursor: pointer;">
          <input type="checkbox" name="system.onHit.dispel.enabled" {{#if onHit.dispel.enabled}}checked{{/if}} />
          <span>{{localize "COG.AbilitySheet.OnHit.DispelsOnHit"}}</span>
        </label>
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.AbilitySheet.OnHit.DispelCount"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.dispel.count" value="{{onHit.dispel.count}}" placeholder="0" min="0" style="font-size: 11px;" />
      </div>
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label">{{localize "COG.AbilitySheet.OnHit.DispelMinRank"}}</span>
        <input class="cog-field-input" type="number" name="system.onHit.dispel.minRank" value="{{onHit.dispel.minRank}}" placeholder="0" min="0" style="font-size: 11px;" />
      </div>
    </div>
    <div class="cog-field-group">
      <span class="cog-field-label">{{localize "COG.AbilitySheet.OnHit.DispelTags"}}</span>
      {{> "systems/sprinter-rpg/templates/items/parts/tag-query-editor.hbs" query=onHit.dispelQuery tagOptions=techniqueTagOptions}}
    </div>
    {{#if onHit.rankNote}}<div class="cog-text-muted" style="font-size: 11px; padding-top: 4px;">{{onHit.rankNote}}</div>{{/if}}
  </div>
</details>
