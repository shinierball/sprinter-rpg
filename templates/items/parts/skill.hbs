<section class="cog-item-body cog-item-body-skill">
<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.Rank"}}</span>
    <input class="cog-field-input" type="number" name="system.rank" value="{{system.rank}}" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.RankHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.ExtraRanks"}}</span>
    <input class="cog-field-input" type="number" name="system.boonBonus" value="{{system.boonBonus}}" placeholder="0" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.ExtraRanksHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.GearRanks"}}</span>
    <input class="cog-field-input" type="number" value="{{system.itemBonus}}" placeholder="0" readonly />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.GearRanksHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.RankUsed"}}</span>
    <input class="cog-field-input cog-bg-gold-tint cog-text-accent" type="number" value="{{system.modifiedRank}}" readonly style="font-weight: bold;" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.RankUsedHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.Stat"}}</span>
    <select name="system.stat" class="cog-field-input">
      {{#each statOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
    </select>
  </div>
  <div class="cog-field-group">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.CheckType"}}</span>
    <select name="system.checkType" class="cog-field-input">
      {{#each checkTypeOptions as |ct|}}
        <option value="{{ct.value}}" {{#if ct.selected}}selected{{/if}}>{{ct.label}}</option>
      {{/each}}
    </select>
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.CheckTypeHint"}}</p>
  </div>
  <div class="cog-field-group">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.Delivery"}}</span>
    <select name="system.delivery" class="cog-field-input">
      {{#each deliveryOptions as |d|}}<option value="{{d.value}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>{{/each}}
    </select>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.Range"}}</span>
    <input class="cog-field-input" type="number" name="system.rangeFeet" value="{{system.rangeFeet}}" min="0" placeholder="0" />
  </div>
  <div class="cog-field-group">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.RankSource"}}</span>
    <select name="system.rankSource" class="cog-field-input">
      {{#each rankSourceOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
    </select>
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.RankSourceHint"}}</p>
  </div>
  <div class="cog-field-group">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.CheckNote"}}</span>
    <input type="text" name="system.checkNote" class="cog-field-input" value="{{system.checkNote}}">
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.CheckNoteHint"}}</p>
  </div>
</div>

<div class="cog-field-row cog-advancement" style="margin-bottom: 8px; flex-wrap: wrap; align-items: flex-end; gap: 8px;">
  <div class="cog-field-group">
    <span class="cog-field-label">{{localize "COG.Skill.Sheet.Advancement"}}</span>
    <button type="button" data-action="rankLimitsPreset" title="{{localize "COG.Skill.Sheet.MagicOnlyHint"}}">{{localize "COG.Skill.Sheet.MagicOnly"}}</button>
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.AdvancementHint"}}</p>
  </div>
  {{#each rankLimitLines as |line|}}
  <div class="cog-field-group small" title="{{line.hint}}">
    <span class="cog-field-label">{{line.lineLabel}}</span>
    <input type="hidden" name="system.rankLimits.{{line.index}}.route" value="{{line.route}}" />
    <input class="cog-field-input" type="number" min="0" name="system.rankLimits.{{line.index}}.maxRank" value="{{line.maxRank}}" placeholder="{{localize "COG.Skill.Sheet.NoLimit"}}" />
  </div>
  {{/each}}
  {{#each unregisteredRankLimits as |row|}}
  <div class="cog-field-group small cog-text-muted" title="{{localize "COG.Skill.Sheet.UnregisteredHint"}}">
    <span class="cog-field-label">{{row.lineLabel}}</span>
    <a class="cog-text-accent" data-action="removeRankLimit" data-index="{{row.storedIndex}}" data-tooltip="{{localize "COG.Skill.Sheet.RemoveLimit"}}" style="cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
  </div>
  {{/each}}
</div>

{{#if specialty.show}}
<div class="cog-field-row cog-specialty" style="margin-bottom: 8px; flex-wrap: wrap; align-items: flex-end; gap: 8px;">
  <div class="cog-field-group" title="{{localize "COG.Skill.Specialty.Hint"}}">
    <span class="cog-field-label">{{localize "COG.Skill.Specialty.Label"}}</span>
    <strong class="cog-specialty-value">{{specialty.label}}</strong>
  </div>
  {{#if specialty.groups.length}}
  <div class="cog-field-group">
    <select class="cog-field-input" data-change-action="setSkillSpecialty">
      <option value="">{{localize "COG.Skill.Specialty.None"}}</option>
      {{#each specialty.groups as |group|}}
        <optgroup label="{{group.label}}">
          {{#each group.options as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </optgroup>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="cog-field-group">
    <span class="cog-field-label">{{localize "COG.Skill.Specialty.Custom"}}</span>
    <input class="cog-field-input" type="text" data-specialty-custom placeholder="item.watch" />
  </div>
  <button type="button" data-action="setSkillSpecialty" data-source="custom"><i class="fa-solid fa-check"></i></button>
  {{#if specialty.value}}
  <button type="button" data-action="clearSkillSpecialty"><i class="fa-solid fa-xmark"></i></button>
  {{/if}}
</div>
{{/if}}

<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap; gap: 12px;">
  {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=cooldownEditor}}
  {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=durationEditor}}
</div>

<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap; align-items: center; gap: 8px;">
  {{> "systems/sprinter-rpg/templates/items/parts/base-damage.hbs"}}
  <div class="cog-field-group" style="display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 14px;">
    <div>
      <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;">
        <input type="checkbox" name="system.isAttack" {{#if system.isAttack}}checked{{/if}} />
        <strong>{{localize "COG.Skill.Sheet.IsAttack"}}</strong>
      </label>
      <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.IsAttackHint"}}</p>
    </div>
    <div>
      <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;">
        <input type="checkbox" name="system.hasDamage" {{#if system.hasDamage}}checked{{/if}} />
        <strong>{{localize "COG.Skill.Sheet.DealsDamage"}}</strong>
      </label>
      <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.DealsDamageHint"}}</p>
    </div>
  </div>
</div>

{{!-- ASSIST (E7.9): dice another crawler's check can gain, and when it is offered --}}
<details class="cog-collapsible-block cog-assist-block" {{#if assist.hasFormula}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-hands-helping"></i> {{localize "COG.Assist.Title"}}</span>
    {{#if isCoreSkill}}<span class="cog-badge cog-badge-core">[CORE]</span>{{/if}}
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row" style="margin-bottom: 6px;">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label" title="{{localize "COG.Assist.FormulaHint"}}">{{localize "COG.Assist.Formula"}}</span>
        <input class="cog-field-input" type="text" name="system.assist.formula" value="{{assist.formula}}" placeholder="1d6" />
        {{#if assist.invalid}}<span class="cog-assist-invalid cog-text-accent" style="font-size: 10px;">{{localize "COG.Assist.Invalid"}}</span>{{/if}}
      </div>
    </div>
    {{#if assist.hasFormula}}
      <div class="cog-field-group">
        <span class="cog-field-label" title="{{localize "COG.Assist.WhenHint"}}">{{localize "COG.Assist.When"}}</span>
        {{> "systems/sprinter-rpg/templates/items/parts/tag-query-editor.hbs" query=assist.whenQuery tagOptions=techniqueTagOptions}}
      </div>
    {{/if}}
  </div>
</details>

{{!-- WEAPON PROFICIENCY, TECHNIQUES & SPECIAL CONDITIONS (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="cog-collapsible-block" {{#if hasTechniqueConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "COG.Skill.Sheet.TechniqueTitle"}}</span>
    <span class="cog-toggle-indicator {{#if hasTechniqueConfigured}}active{{/if}}">{{#if hasTechniqueConfigured}}{{localize "COG.Skill.Sheet.TechniqueConfigured"}}{{else}}{{localize "COG.Skill.Sheet.TechniqueIdle"}}{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row" style="margin-bottom: 6px; align-items: center; gap: 8px;">
      <label class="cog-text" style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer;">
        <input type="checkbox" name="system.isTechnique" {{#if system.isTechnique}}checked{{/if}} />
        <span>{{localize "COG.Skill.Sheet.IsTechnique"}}</span>
      </label>
    </div>
    <div class="cog-field-row" style="margin-bottom: 6px;"><p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.IsTechniqueHint"}}</p></div>
    {{#if system.isTechnique}}
      <div class="cog-field-row" style="margin-bottom: 6px; align-items: center; gap: 12px;">
        <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;">
          <input type="checkbox" name="system.techniqueConfig.isDamageEffect" {{#if system.techniqueConfig.isDamageEffect}}checked{{/if}} />
          <strong>{{localize "COG.Skill.Sheet.DamageEffect"}}</strong>
        </label>
      </div>
      <div class="cog-field-row" style="margin-bottom: 6px;">
        <div class="cog-field-group" style="flex: 2;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.AppliesTo"}}</span>
          {{> "systems/sprinter-rpg/templates/items/parts/tag-query-editor.hbs" query=appliesToQuery tagOptions=techniqueTagOptions}}
          <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.AppliesToHint"}}</p>
        </div>
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.BaseDiceCountMod"}}</span>
          <input class="cog-field-input" type="text" name="system.techniqueConfig.baseDiceCountMod" value="{{system.techniqueConfig.baseDiceCountMod}}" placeholder="{{localize "COG.Skill.Sheet.BaseDiceCountModExample"}}" style="font-size: 11px;" />
          <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.BaseDiceCountModHint"}}</p>
        </div>
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.FlatDamage"}}</span>
          <input class="cog-field-input" type="text" name="system.techniqueConfig.flatDamageMod" value="{{system.techniqueConfig.flatDamageMod}}" placeholder="{{localize "COG.Skill.Sheet.FlatDamageExample"}}" style="font-size: 11px;" />
        </div>
      </div>
      <div class="cog-field-row" style="margin-bottom: 6px;">
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.TechniqueDescription"}}</span>
          <input class="cog-field-input" type="text" name="system.techniqueConfig.description" value="{{system.techniqueConfig.description}}" style="font-size: 11px;" />
          <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.TechniqueDescriptionHint"}}</p>
        </div>
      </div>
      <div class="cog-field-row" style="margin-bottom: 6px;">
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.DamageBonus"}}</span>
          <input class="cog-field-input" type="text" name="system.techniqueConfig.damageBonus" value="{{system.techniqueConfig.damageBonus}}" placeholder="{{localize "COG.Skill.Sheet.DamageBonusExample"}}" style="font-size: 11px;" />
        </div>
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.BonusDamageType"}}</span>
          <select class="cog-field-input" name="system.techniqueConfig.damageType" style="font-size: 11px;">
            <option value="">{{localize "COG.Skill.Sheet.SameAsAttack"}}</option>
            {{#each damageTypes as |dt|}}
              <option value="{{dt}}" {{#if (eq ../system.techniqueConfig.damageType dt)}}selected{{/if}}>{{dt}}</option>
            {{/each}}
          </select>
        </div>
        <div class="cog-field-group" style="flex: 1;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.OnUseDebuff"}}</span>
          <select class="cog-field-input" name="system.techniqueConfig.debuffId" style="font-size: 11px;">
            <option value="">{{localize "COG.Skill.Sheet.None"}}</option>
            {{#each availableDebuffs as |deb|}}
              <option value="{{deb.system.identifier}}" {{#if (sameDebuff ../system.techniqueConfig.debuffId deb.system.identifier)}}selected{{/if}}>{{deb.name}}</option>
            {{/each}}
          </select>
        </div>
        <div class="cog-field-group small" style="text-align: center;">
          <span class="cog-field-label">{{localize "COG.Skill.Sheet.ArmorPierce"}}</span>
          <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;">
            <input class="cog-checkbox-lg" type="checkbox" name="system.techniqueConfig.isArmorPiercing" {{#if system.techniqueConfig.isArmorPiercing}}checked{{/if}} />
          </label>
          <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.ArmorPierceHint"}}</p>
        </div>
      </div>
    {{/if}}

    <div class="cog-field-row" style="margin-bottom: 6px;">
      <div class="cog-field-group" style="flex: 1;">
        <span class="cog-field-label"><i class="fa-solid fa-triangle-exclamation cog-text-warning"></i> {{localize "COG.Skill.Sheet.Fumble"}}</span>
        <select class="cog-field-input" name="system.fumbleDebuff" style="font-size: 11px;">
          <option value="">{{localize "COG.Skill.Sheet.None"}}</option>
          {{#each availableDebuffs as |deb|}}
            <option value="{{deb.system.identifier}}" {{#if (sameDebuff ../system.fumbleDebuff deb.system.identifier)}}selected{{/if}}>{{deb.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="cog-field-group small">
        <span class="cog-field-label">{{localize "COG.Skill.Sheet.Crit5"}}</span>
        <input class="cog-field-input" type="number" name="system.critMultiplierR5" value="{{system.critMultiplierR5}}" min="1" placeholder="1" style="font-size: 11px;" />
      </div>
      <div class="cog-field-group small">
        <span class="cog-field-label">{{localize "COG.Skill.Sheet.Crit15"}}</span>
        <input class="cog-field-input" type="number" name="system.critMultiplierR15" value="{{system.critMultiplierR15}}" min="1" placeholder="1" style="font-size: 11px;" />
        <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Skill.Sheet.CritHint"}}</p>
      </div>
    </div>

  </div>
</details>

{{> "systems/sprinter-rpg/templates/items/parts/on-hit.hbs"}}

{{> "systems/sprinter-rpg/templates/items/parts/ability/healing.hbs" barsPlaceholder="1 or 1 + con"}}

{{> "systems/sprinter-rpg/templates/items/parts/aura.hbs" titleKey="COG.AuraSheet.AbilityTitle" emitsKey="COG.AuraSheet.AbilityEmits" configureKey="COG.AuraSheet.AbilityConfigure"}}

{{> "systems/sprinter-rpg/templates/items/parts/contest.hbs"}}

{{> "systems/sprinter-rpg/templates/items/parts/ability/rank-breaks.hbs"}}

{{> "systems/sprinter-rpg/templates/items/parts/ability/rank-damage-parts.hbs"}}


<div class="cog-field-group" style="margin-bottom: 8px;">
  <span class="cog-field-label">{{localize "COG.Skill.Sheet.Notes"}}</span>
  <textarea class="cog-field-input" name="system.notes" style="height: 120px;">{{system.notes}}</textarea>
</div>
<div class="cog-field-group" style="margin-bottom: 8px;">
  <span class="cog-field-label">{{localize "COG.Skill.Sheet.Description"}}</span>
  {{editor descriptionHtml target="system.description" button=true editable=editable engine="prosemirror" collaborate=false}}
</div>

{{#if availableBuffs.length}}
  <datalist id="cog-available-buffs-list-{{item.id}}">
    {{#each availableBuffs as |b|}}
      <option value="{{b.system.identifier}}">{{b.name}}</option>
    {{/each}}
  </datalist>
{{/if}}

{{#if availableDebuffs.length}}
  <datalist id="cog-available-debuffs-list-{{item.id}}">
    {{#each availableDebuffs as |d|}}
      <option value="{{d.system.identifier}}">{{d.name}}</option>
    {{/each}}
  </datalist>
{{/if}}
</section>
