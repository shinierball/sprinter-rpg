{{!-- The source chip (7.7d): `badge` is sourceBadge(doc) from src/utils/content-source.mjs (null shows nothing). `text=true` adds the set label after the symbol. No name attribute: this is a readout. --}}
{{#if badge}}<span class="cog-provenance-chip cog-fg-dyn" data-provenance="source" data-source-theme="{{badge.theme}}" data-source-set="{{badge.set}}"{{#if badge.off}} data-source-off="true"{{/if}} data-tooltip="{{badge.tooltip}}" style="--cog-fg-dyn: var({{badge.color}});"><i class="{{badge.icon}}"></i><span class="cog-source-symbol">{{badge.symbol}}</span>{{#if badge.authorship}}<i class="cog-authorship-glyph {{badge.authorship.icon}}" data-authorship="{{badge.authorship.id}}"></i>{{/if}}{{#if text}}<span class="cog-source-label">{{badge.label}}</span>{{/if}}</span>{{/if}}
