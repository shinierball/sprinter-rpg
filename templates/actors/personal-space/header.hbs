  <header class="cog-sheet-header cog-bg-window" style="border-bottom: 2px solid var(--cog-magic); padding: 12px; display: flex; gap: 14px; align-items: center;">
    <img class="profile-img cog-bg-icon-box" data-action="editImage" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="72" width="72" style="border: 2px solid var(--cog-magic); border-radius: 4px; object-fit: cover;" />

    <div style="flex: 1; display: flex; flex-direction: column; gap: 4px;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <input class="cog-text-warning cog-bg-transparent" name="name" type="text" value="{{actor.name}}" placeholder="Safe Space Name..." style="font-family: 'Oswald', sans-serif; font-size: 20px; font-weight: bold; border: none; border-bottom: 1px dashed var(--cog-panel-border); width: 65%;" />
        <span class="cog-bg-magic-fill cog-text-on-fill" style="font-family: 'Oswald', sans-serif; font-size: 11px; text-transform: uppercase; padding: 3px 8px; border-radius: 3px; font-weight: bold; letter-spacing: 1px;">
          TIER {{system.tier}} {{system.size}}
        </span>
        {{#if ruleBreak}}<span class="cog-badge cog-badge-rule-break" title="{{ruleBreakReason}}">[RULE BREAK]</span>{{/if}}
      </div>

      <div class="cog-text-secondary" style="display: flex; gap: 16px; font-size: 12px; font-family: 'Oswald', sans-serif; align-items: center; margin-top: 4px;">
        <span><i class="fa-solid fa-shield-halved cog-text-success"></i> Defense: <strong class="cog-text-strong">{{system.effectiveDefenseRating}}</strong></span>
        <span><i class="fa-solid fa-vault cog-text-warning"></i> Stash: <strong class="cog-text-strong">{{stashStats.count}} / {{stashStats.max}}</strong></span>
        <span><i class="fa-solid fa-bed cog-text-info"></i> Rest: <strong class="cog-text-strong">{{restHours}}h</strong> (Base 8h)</span>
        {{#if owner}}
          <span><i class="fa-solid fa-user-shield cog-text-warning"></i> Owner: <strong class="cog-text-strong">{{owner.name}}</strong></span>
        {{/if}}
      </div>
    </div>

    <div>
      <button class="cog-bg-warning-fill cog-text-on-fill" type="button" data-action="openStash" style="border: 1px solid var(--cog-warning-fill); border-radius: 4px; padding: 8px 14px; font-family: 'Oswald', sans-serif; font-size: 12px; font-weight: bold; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;">
        <i class="fa-solid fa-right-left"></i> Stash Manager
      </button>
    </div>
  </header>

