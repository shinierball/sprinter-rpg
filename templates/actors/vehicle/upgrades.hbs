{{!-- Upgrades (3.44g): gear on the vehicle, grouped by upgrade kind. Installed = equipped. Drop a gear item here to install it. --}}
<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="upgrades">
<div class="cog-page-container cog-vehicle-upgrades">
  <div class="cog-stat-block">
    <div class="cog-banner-header cog-bg-header-fill cog-text-on-fill">
      <span><i class="fa-solid fa-screwdriver-wrench"></i> UPGRADES &amp; GEAR ({{upgradeCount}})</span>
      <span class="cog-vehicle-upgrade-tools">
        <a class="cog-dark cog-text-gold" data-action="openGearPicker" data-tooltip="Browse the gear compendium"><i class="fa-solid fa-sparkles"></i> Browse Gear</a>
        <a class="cog-text-on-fill" data-action="createItem" data-type="gear" data-tooltip="Create a custom upgrade"><i class="fa-solid fa-plus"></i> New Upgrade</a>
      </span>
    </div>
    {{#each upgradeGroups as |group|}}
      <div class="cog-vehicle-upgrade-group" data-upgrade-kind="{{group.id}}">
        <div class="cog-vehicle-upgrade-heading">{{group.label}}</div>
        <table class="cog-attacks-table">
          <tbody>
            {{#each group.items as |item|}}
              <tr class="draggable{{#if item.system.equipped}} cog-bg-danger-tint{{/if}}" data-item-id="{{item.id}}" draggable="true">
                <td>
                  <div class="cog-vehicle-upgrade-name">
                    <button class="cog-bg-none" type="button" data-action="toggleGearEquipped" data-tooltip="{{#if item.system.equipped}}Installed (click to uninstall){{else}}Not installed (click to install){{/if}}">
                      {{#if item.system.equipped}}<i class="fa-solid fa-screwdriver-wrench cog-text-accent"></i>{{else}}<i class="fa-regular fa-circle cog-text-secondary"></i>{{/if}}
                    </button>
                    <div>
                      <span{{#if item.summaryTip}} data-tooltip="{{item.summaryTip}}"{{/if}} class="cog-vehicle-upgrade-title">{{item.name}}</span>
                      {{> "systems/sprinter-rpg/templates/apps/partials/cooldown-badge.hbs" badge=item.cooldownBadge}}
                      {{#if item.system.equipped}}<span class="cog-badge cog-bg-accent-fill cog-text-on-fill">INSTALLED</span>{{/if}}
                      {{#if item.brokenState}}<span class="cog-badge cog-bg-danger-fill cog-text-on-fill">{{item.brokenLabel}}</span>{{/if}}
                      {{#if item.bonusesSummary}}<div class="cog-text cog-vehicle-upgrade-effects">{{item.bonusesSummary}}</div>{{/if}}
                    </div>
                  </div>
                </td>
                <td class="cog-vehicle-upgrade-actions">
                  {{#if item.isMountedWeapon}}<a class="cog-text-accent" data-action="vehicleFireWeapon" data-vehicle-uuid="{{item.vehicleUuid}}" data-weapon-id="{{item.id}}" data-tooltip="Fire (the driver, a gunner, or a passenger as a Rule Break)"><i class="fa-solid fa-crosshairs"></i></a>{{/if}}
                  {{#if item.canActivate}}<a class="cog-text-accent" data-action="useItem" data-tooltip="Activate"><i class="fa-solid fa-bolt"></i></a>{{/if}}
                  <a class="item-edit" data-action="editItem" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
                  <a class="item-delete" data-action="deleteItem" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="cog-text-muted cog-vehicle-empty">No upgrades yet. Drop a gear item here to install it.</div>
    {{/each}}
  </div>
</div>
</section>
