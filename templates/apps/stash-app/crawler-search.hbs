<div class="cog-stash-pane-top cog-stash-crawler-top cog-bg-surface">
  <div class="cog-bg-surface-muted" style="padding: 8px 12px; border-bottom: 1px solid var(--cog-panel-border);">
    <span class="cog-text-info" style="font-weight: bold; letter-spacing: 1px;">
      <i class="fa-solid fa-person-walking-luggage"></i> {{crawler.name}}'S BACKPACK
    </span>
  </div>
  <div style="padding: 8px; border-bottom: 1px solid var(--cog-panel-border);">
    <input type="text" name="searchCrawler" data-input-action="setSearchCrawler" class="crawler-search-input cog-bg-window cog-text-strong" value="{{searchCrawler}}" placeholder="Search inventory..." style="width: 100%; box-sizing: border-box; border: 1px solid var(--cog-panel-border); padding: 5px 8px; border-radius: 3px; font-family: 'Oswald', sans-serif; font-size: 12px;" />
  </div>
</div>
