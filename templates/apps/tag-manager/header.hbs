<div class="cog-tm-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--cog-accent); padding-bottom: 8px; margin-bottom: 10px;">
  <div>
    <h2 class="cog-text-strong" style="margin: 0; font-family: 'Oswald', sans-serif; text-transform: uppercase; font-size: 20px;">
      <i class="fa-solid fa-tags cog-text-accent"></i> Tag Manager & Taxonomy
    </h2>
    <div class="cog-text-muted" style="font-size: 11px;">
      Explore, filter, and inspect built-in keywords and custom system tags across the game engine.
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 8px;">
    <button type="button" data-action="openGuide" class="cog-btn cog-open-tag-guide-btn cog-bg-success-fill cog-text-on-fill" title="Open Tag System & Content Creation Guide" style="border: 1px solid var(--cog-success-fill); padding: 4px 10px; font-family: 'Oswald', sans-serif; font-size: 11px; cursor: pointer; border-radius: 3px; display: inline-flex; align-items: center; gap: 4px;">
      <i class="fa-solid fa-book-open"></i> Tag Guide
    </button>
    <div class="cog-text" style="font-family: 'Oswald', sans-serif; font-size: 13px; font-weight: bold;">
      Total Tags: {{totalTagsCount}}
    </div>
  </div>
</div>
