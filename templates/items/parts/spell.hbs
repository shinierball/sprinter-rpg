<section class="cog-item-body cog-item-body-spell">
{{#if system.quote}}
  <div class="cog-spell-quote-box cog-bg-surface cog-text-gold" style="font-style: italic; padding: 8px 12px; border-left: 4px solid var(--cog-danger); border-radius: 4px; margin-bottom: 10px; font-size: 13px; font-family: 'Gelasio', Georgia, serif;">
    “{{system.quote}}”
  </div>
{{/if}}

<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.ManaCost"}}</span>
    <input class="cog-field-input cog-text-info" type="number" name="system.manaCost" value="{{system.manaCost}}" style="font-weight: bold;" />
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.Range"}}</span>
    <input class="cog-field-input" type="text" name="system.range" value="{{system.range}}" placeholder="{{localize "COG.Spell.Sheet.RangePlaceholder"}}" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Spell.Sheet.RangeHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.Delivery"}}</span>
    <select name="system.delivery" class="cog-field-input">
      {{#each deliveryOptions as |d|}}<option value="{{d.value}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>{{/each}}
    </select>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.Duration"}}</span>
    <input class="cog-field-input" type="text" name="system.duration" value="{{system.duration}}" placeholder="{{localize "COG.Spell.Sheet.DurationPlaceholder"}}" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Spell.Sheet.DurationHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.AiFavor"}}</span>
    <input class="cog-field-input cog-text-warning" type="number" name="system.aiFavor" value="{{system.aiFavor}}" placeholder="0" />
  </div>
</div>

<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap; gap: 12px;">
  {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=cooldownEditor}}
  {{> "systems/sprinter-rpg/templates/items/parts/timing.hbs" timing=durationEditor}}
</div>

<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.CheckType"}}</span>
    <select class="cog-field-input" name="system.checkType">
      {{#each checkTypeOptions as |ct|}}
        <option value="{{ct.value}}" {{#if ct.selected}}selected{{/if}}>{{ct.label}}</option>
      {{/each}}
    </select>
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Spell.Sheet.CheckTypeHint"}}</p>
  </div>
  <div class="cog-field-group small">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.Stat"}}</span>
    <select name="system.stat" class="cog-field-input">
      {{#each statOptions as |st|}}<option value="{{st.value}}" {{#if st.selected}}selected{{/if}}>{{st.label}}</option>{{/each}}
    </select>
  </div>
  {{> "systems/sprinter-rpg/templates/items/parts/base-damage.hbs"}}
  <div class="cog-field-group small" style="text-align: center; max-width: 90px;">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.ArmorPierce"}}</span>
    <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;" title="{{localize "COG.Spell.Sheet.ArmorPierceTip"}}">
      <input class="cog-checkbox-lg" type="checkbox" name="system.ignoreDR" {{#if system.ignoreDR}}checked{{/if}} />
    </label>
  </div>
</div>

<div class="cog-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
  <div class="cog-field-group" style="flex: 1;" data-tag-entry>
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.FavoredBy"}}</span>
    <div class="cog-favored-picker cog-tag-pills" style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
      {{#each favoredPicker.tags as |tag|}}
        <span class="cog-tag-pill cog-bg-info-tint cog-text-info" style="display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--cog-info-border); padding: 2px 6px; border-radius: 12px; font-size: 11px;" title="{{tag.id}}">
          <span>{{tag.label}}</span>
          <a class="cog-text-accent" data-action="removeTag" data-tag-id="{{tag.id}}" title="{{localize "COG.Spell.Sheet.FavoredRemove"}}" style="cursor: pointer; font-weight: bold;">&times;</a>
        </span>
      {{else}}
        <span class="cog-text-muted" style="font-size: 11px; font-style: italic;">{{localize "COG.Spell.Sheet.FavoredNone"}}</span>
      {{/each}}
      {{#if favoredPicker.options.length}}
        <select class="cog-field-input" style="width: auto; font-size: 11px;">
          {{#each favoredPicker.options as |opt|}}
            <option value="{{opt.id}}">{{opt.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="cog-btn cog-bg-success-fill cog-text-on-fill" data-action="addTag" style="border: 1px solid var(--cog-success-fill); padding: 2px 8px; font-size: 11px; cursor: pointer; border-radius: 3px;">
          <i class="fa-solid fa-plus"></i> {{localize "COG.Spell.Sheet.FavoredAdd"}}
        </button>
      {{/if}}
    </div>
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Spell.Sheet.FavoredHint"}}</p>
  </div>
  <div class="cog-field-group" style="flex: 2;">
    <span class="cog-field-label">{{localize "COG.Spell.Sheet.Limitations"}}</span>
    <input class="cog-field-input" type="text" name="system.limitations" value="{{system.limitations}}" placeholder="{{localize "COG.Spell.Sheet.LimitationsPlaceholder"}}" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Spell.Sheet.LimitationsHint"}}</p>
  </div>
</div>

<div class="cog-field-group" style="margin-bottom: 8px;">
  <span class="cog-field-label">{{localize "COG.Spell.Sheet.Description"}}</span>
  {{editor descriptionHtml target="system.description" button=true editable=editable engine="prosemirror" collaborate=false}}
</div>

{{> "systems/sprinter-rpg/templates/items/parts/ability/healing.hbs" barsPlaceholder="2 or 2 + int"}}

{{> "systems/sprinter-rpg/templates/items/parts/aura.hbs" titleKey="COG.AuraSheet.AbilityTitle" emitsKey="COG.AuraSheet.AbilityEmits" configureKey="COG.AuraSheet.AbilityConfigure"}}

{{!-- Fumble --}}
<details class="cog-collapsible-block" {{#if hasConditionTriggersConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-crosshairs"></i> {{localize "COG.Spell.Sheet.Fumble"}}</span>
    <span class="cog-toggle-indicator {{#if hasConditionTriggersConfigured}}active{{/if}}">{{#if hasConditionTriggersConfigured}}{{localize "COG.Spell.Sheet.FumbleConfigured"}}{{else}}{{localize "COG.Spell.Sheet.FumbleOpen"}}{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div class="cog-field-row" style="margin-bottom: 6px;">
      <div class="cog-field-group" style="flex: 1.5;">
        <span class="cog-field-label"><i class="fa-solid fa-triangle-exclamation cog-text-warning"></i> {{localize "COG.Spell.Sheet.FumbleDebuff"}}</span>
        <select class="cog-field-input" name="system.fumbleDebuff" style="font-size: 11px;">
          <option value="">{{localize "COG.Spell.Sheet.FumbleNone"}}</option>
          {{#each availableDebuffs as |deb|}}
            <option value="{{deb.system.identifier}}" {{#if (sameDebuff ../system.fumbleDebuff deb.system.identifier)}}selected{{/if}}>{{deb.name}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </div>
</details>

{{> "systems/sprinter-rpg/templates/items/parts/on-hit.hbs"}}

{{> "systems/sprinter-rpg/templates/items/parts/ability/rank-damage-parts.hbs"}}

{{!-- OPTIONAL EFFECTS & METAMAGIC RIDERS --}}
<div class="cog-field-group" style="margin-bottom: 8px;">
  <span class="cog-field-label"><i class="fa-solid fa-wand-magic"></i> {{localize "COG.Spell.Sheet.Riders"}}</span>
  <input class="cog-field-input" type="text" name="system.optionalEffects" value="{{optionalEffectsString}}" placeholder="{{localize "COG.Spell.Sheet.RidersPlaceholder"}}" />
    <p class="cog-rule-hint"><i class="fa-solid fa-circle-info"></i> {{localize "COG.Spell.Sheet.RidersHint"}}</p>
</div>

{{> "systems/sprinter-rpg/templates/items/parts/contest.hbs"}}

{{> "systems/sprinter-rpg/templates/items/parts/ability/rank-breaks.hbs"}}

<button type="button" class="cog-btn cog-dark cog-bg-header-fill cog-text-on-fill" data-action="rollSpell" style="width: 100%; border: 2px solid var(--cog-ink); padding: 6px; font-weight: bold; cursor: pointer; border-radius: 4px;">
  <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "COG.Spell.Sheet.Cast"}}
</button>
{{#if hasDamage}}
  <button type="button" class="cog-btn cog-bg-accent-fill cog-text-on-fill" data-action="rollSpellDamage" style="width: 100%; margin-top: 6px; border: 2px solid var(--cog-ink); padding: 6px; font-weight: bold; cursor: pointer; border-radius: 4px;">
    <i class="fa-solid fa-burst"></i> {{localize "COG.Spell.Sheet.RollDamage"}}{{#if damageFormula}} ({{damageFormula}}){{/if}}
  </button>
{{/if}}

{{#if availableBuffs.length}}
  <datalist id="cog-available-buffs-list-{{item.id}}">
    {{#each availableBuffs as |b|}}
      <option value="{{b.system.identifier}}">{{b.name}}</option>
    {{/each}}
  </datalist>
{{/if}}

{{#if availableDebuffs.length}}
  <datalist id="cog-available-debuffs-list-{{item.id}}">
    {{#each availableDebuffs as |d|}}
      <option value="{{d.system.identifier}}">{{d.name}}</option>
    {{/each}}
  </datalist>
{{/if}}
</section>
