{{!-- SKILL RANK DAMAGE PARTS (RANK GATED) (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="cog-collapsible-block" {{#if hasRankDamagePartsConfigured}}open{{/if}}>
  <summary class="cog-collapsible-summary">
    <span class="cog-collapsible-title"><i class="fa-solid fa-chevron-right cog-chevron"></i> <i class="fa-solid fa-bolt"></i> RANK DAMAGE PARTS (SCALING)</span>
    <span class="cog-toggle-indicator {{#if hasRankDamagePartsConfigured}}active{{/if}}">{{#if hasRankDamagePartsConfigured}}[RANK DAMAGE PARTS ({{system.rankDamageParts.length}})]{{else}}[CLICK TO ADD RANK DAMAGE PARTS]{{/if}}</span>
  </summary>
  <div class="cog-collapsible-content">
    <div style="display: flex; justify-content: flex-end; margin-bottom: 6px;">
      <a class="cog-text-info" data-action="addRow" data-row-table="rankDamagePart" style="font-size: 11px; cursor: pointer; font-weight: bold;">
        <i class="fa-solid fa-plus"></i> Add Rank Damage Part
      </a>
    </div>
    {{#if system.rankDamageParts.length}}
      <table class="cog-table" style="margin: 0; font-size: 11px;">
        <thead>
          <tr>
            <th style="width: 30%;">Damage Type</th>
            <th style="width: 20%;">Fixed Bonus</th>
            <th style="width: 25%;">Dice (Optional)</th>
            <th style="width: 20%;">Min Rank</th>
            <th style="width: 5%;"></th>
          </tr>
        </thead>
        <tbody>
          {{#each system.rankDamageParts as |mod idx|}}
            <tr>
              <td>
                <select class="cog-field-input" name="system.rankDamageParts.{{idx}}.type" style="font-size: 11px;">
                  {{#each ../damageTypes as |dt|}}
                    <option value="{{dt}}" {{#if (eq mod.type dt)}}selected{{/if}}>{{dt}}</option>
                  {{/each}}
                </select>
              </td>
              <td>
                <input class="cog-stat-input" type="number" name="system.rankDamageParts.{{idx}}.value" value="{{mod.value}}" placeholder="2" style="width: 100%; font-size: 11px;" />
              </td>
              <td>
                <input class="cog-field-input" type="text" name="system.rankDamageParts.{{idx}}.dice" value="{{mod.dice}}" placeholder="1d4" style="width: 100%; font-size: 11px;" />
              </td>
              <td>
                <input class="cog-stat-input" type="number" name="system.rankDamageParts.{{idx}}.minRank" value="{{mod.minRank}}" placeholder="0" style="width: 100%; font-size: 11px;" />
              </td>
              <td style="text-align: center;">
                <a class="cog-text-accent" data-action="deleteRow" data-row-table="rankDamagePart" data-index="{{idx}}" data-tooltip="Delete" style="cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <div class="cog-text" style="text-align: center; font-style: italic; font-size: 11px; padding: 6px;">
        No attack damage bonuses. Click "Add Rank Damage Part" above to add scaling or typed damage to attacks.
      </div>
    {{/if}}
  </div>
</details>


<div class="cog-field-group" style="margin-bottom: 8px;">
  <span class="cog-field-label">Notes & Upgrades</span>
  <textarea class="cog-field-input" name="system.notes" style="height: 120px;">{{system.notes}}</textarea>
</div>

