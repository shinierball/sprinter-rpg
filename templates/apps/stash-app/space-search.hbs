<div class="cog-stash-pane-top cog-stash-space-top cog-bg-surface">
  <div class="cog-bg-surface-muted" style="padding: 8px 12px; border-bottom: 1px solid var(--cog-panel-border);">
    <span class="cog-text-warning" style="font-weight: bold; letter-spacing: 1px;">
      <i class="fa-solid fa-dungeon"></i> SAFE ROOM VAULT
    </span>
  </div>
  <div style="padding: 8px; border-bottom: 1px solid var(--cog-panel-border);">
    <input type="text" name="searchSpace" data-input-action="setSearchSpace" class="space-search-input cog-bg-window cog-text-strong" value="{{searchSpace}}" placeholder="Search vault..." style="width: 100%; box-sizing: border-box; border: 1px solid var(--cog-panel-border); padding: 5px 8px; border-radius: 3px; font-family: 'Oswald', sans-serif; font-size: 12px;" />
  </div>
</div>
