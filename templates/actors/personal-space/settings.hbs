<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="settings">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
    <div class="cog-field-group">
      <span class="cog-field-label">Space Type</span>
      <strong class="cog-text-strong">{{system.typeLabel}}</strong>
    </div>

    <div class="cog-field-group">
      <span class="cog-field-label">Rank</span>
      {{#if isGM}}
        <input name="system.rank" type="number" min="1" step="1" value="{{system.rank}}" class="cog-field-input cog-bg-window cog-text-strong" style="border: 1px solid var(--cog-panel-border); padding: 6px; border-radius: 3px; font-family: 'Oswald', sans-serif;" />
      {{else}}
        <strong class="cog-text-strong">{{system.rank}}</strong>
      {{/if}}
    </div>
  </div>

  <div style="margin-bottom: 14px;">
    <span class="cog-field-label">Notes & Layout Description</span>
    <textarea class="cog-bg-window cog-text-strong" name="system.details.notes" style="width: 100%; height: 80px; border: 1px solid var(--cog-panel-border); padding: 8px; border-radius: 3px; font-family: 'Oswald', sans-serif;">{{system.details.notes}}</textarea>
  </div>

  <div class="cog-space-occupants-title">
    <i class="fa-solid fa-users"></i> CO-TENANTS & AUTHORIZED OCCUPANTS
  </div>
  <div class="cog-space-occupants">
    {{#each occupants as |occ|}}
      <div class="cog-space-occupant" data-crawler-uuid="{{occ.uuid}}">
        <div class="cog-space-occupant-who">
          <img class="cog-bg-icon-box" src="{{occ.img}}" width="28" height="28" />
          <span class="cog-space-occupant-name">{{occ.name}}</span>
          {{#if occ.isOwner}}<span class="cog-space-owner-tag">PRIMARY OWNER</span>{{/if}}
        </div>
        <div class="cog-space-occupant-actions">
          {{#if occ.canRemove}}
            <button type="button" data-action="removeOccupant" data-crawler-uuid="{{occ.uuid}}" title="Remove from this space">
              <i class="fa-solid fa-user-minus"></i> Remove
            </button>
          {{else if occ.canLeave}}
            <button type="button" data-action="leaveSpace" data-crawler-uuid="{{occ.uuid}}" title="Leave this space">
              <i class="fa-solid fa-door-open"></i> Leave
            </button>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div class="cog-space-empty">No occupants listed.</div>
    {{/each}}
  </div>
  {{#if availableOccupants.length}}
    <div class="cog-space-occupant-add">
      <select class="occupant-select cog-field-input">
        {{#each availableOccupants as |c|}}
          <option value="{{c.uuid}}">{{c.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="addOccupant"><i class="fa-solid fa-user-plus"></i> Add Occupant</button>
    </div>
  {{/if}}

  <div class="cog-space-occupants-title">
    <i class="fa-solid fa-link"></i> {{localize "COG.SpaceJoin.Title"}}
  </div>
  <div class="cog-text-secondary" style="font-size: 11px; margin-bottom: 6px;">{{localize "COG.SpaceJoin.Hint"}}</div>
  <div class="cog-space-occupants cog-space-joined">
    {{#each joining.linked as |link|}}
      <div class="cog-space-occupant" data-space-uuid="{{link.uuid}}">
        <div class="cog-space-occupant-who">
          <span class="cog-space-occupant-name">{{link.name}} (Rank {{link.rank}})</span>
        </div>
        <div class="cog-space-occupant-actions">
          {{#if link.canDetach}}
            <button type="button" data-action="detachSpace" data-space-uuid="{{link.uuid}}"><i class="fa-solid fa-link-slash"></i> {{localize "COG.SpaceJoin.Detach"}}</button>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div class="cog-space-empty">{{localize "COG.SpaceJoin.None"}}</div>
    {{/each}}
  </div>
  {{#if joining.canJoin}}{{#if joining.options.length}}
    <div class="cog-space-occupant-add">
      {{#if purchase.canPurchase}}
        <select class="cog-space-payer" data-change-action="setPayer">
          {{#each purchase.payers as |p|}}<option value="{{p.uuid}}" {{#if p.selected}}selected{{/if}}>{{p.name}}</option>{{/each}}
        </select>
      {{/if}}
      <select class="cog-join-target cog-field-input">
        {{#each joining.options as |o|}}
          <option value="{{o.uuid}}">{{o.name}}{{#if o.note}} ({{o.note}}){{/if}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="joinSpace"><i class="fa-solid fa-link"></i> {{localize "COG.SpaceJoin.Join"}} &middot; {{joining.priceLabel}}</button>
    </div>
  {{/if}}{{/if}}
</section>
