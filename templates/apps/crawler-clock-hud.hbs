<div class="cog-hud-content {{#if isCollapsed}}collapsed{{/if}}" data-tooltip="Surviving Crawler Countdown Clock">
  {{#if isCollapsed}}
    <div class="cog-crawler-hud-pill-collapsed" style="display: flex; align-items: center; gap: 6px; padding: 3px 8px;">
      <button type="button" data-action="toggleCollapsed" class="cog-crawler-hud-toggle-btn cog-bg-none cog-text-on-fill" title="Crawler Countdown Clock: {{formattedCrawlerCount}} Remaining Crawlers. Click to expand." style="border: none; cursor: pointer; display: flex; align-items: center; gap: 5px; font-family: 'Oswald', sans-serif; font-size: 13px; padding: 0;">
        <i class="fa-solid fa-users cog-text-danger"></i>
        <span class="cog-crawler-hud-collapsed-val cog-text-danger" style="font-weight: bold;">{{formattedCrawlerCount}}</span>
      </button>
    </div>
  {{else}}
    <div class="cog-crawler-hud-inner">
      <div class="cog-crawler-hud-icon-wrap" title="Surviving Crawler Countdown Clock">
        <i class="fa-solid fa-users cog-text-danger" style="font-size: 15px;"></i>
      </div>
      <div class="cog-crawler-hud-body">
        <div class="cog-crawler-hud-title">
          <span class="cog-hud-crawler-badge">SURVIVING</span>
          <span class="cog-hud-label">Crawler Count</span>
        </div>
        <div class="cog-crawler-hud-time-row">
          {{#if isGM}}
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="-10000" title="Subtract 10,000 Crawlers">-10k</button>
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="-1000" title="Subtract 1,000 Crawlers">-1k</button>
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="-100" title="Subtract 100 Crawlers">-100</button>
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="-1" title="Subtract 1 Crawler">-1</button>
            <input type="text" name="crawlerCount" data-change-action="setCrawlerCount" class="cog-hud-crawler-input" value="{{formattedCrawlerCount}}" title="Edit Crawler Count. Press Enter to save." />
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="1" title="Add 1 Crawler">+1</button>
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="100" title="Add 100 Crawlers">+100</button>
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="1000" title="Add 1,000 Crawlers">+1k</button>
            <button type="button" class="cog-crawler-hud-adj-btn" data-action="adjustCount" data-delta="10000" title="Add 10,000 Crawlers">+10k</button>
          {{else}}
            <span class="cog-crawler-hud-time-display">{{formattedCrawlerCount}} <small>CRAWLERS</small></span>
          {{/if}}
        </div>
      </div>
      <div class="cog-crawler-hud-actions">
        <button type="button" data-action="toggleCollapsed" class="cog-crawler-hud-collapse-btn" title="Minimize Crawler Clock HUD">
          <i class="fa-solid fa-chevron-up"></i>
        </button>
      </div>
    </div>
  {{/if}}
</div>
