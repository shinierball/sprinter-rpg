      <div class="cog-field-row">
        <div class="cog-field-group flex-2">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="cog-field-label">Name</span>
            {{#if noBookText}}<span class="cog-badge cog-badge-no-book-text" title="{{noBookText.tooltip}}">{{noBookText.label}}</span>{{/if}}
          </div>
          <input class="cog-field-input" name="name" type="text" value="{{actor.name}}" placeholder="Vehicle Name" />
        </div>
        <div class="cog-field-group flex-1">
          <span class="cog-field-label">Vehicle Type</span>
          <select class="cog-field-input" name="system.vehicleType">
            {{#each vehicleTypeOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="cog-field-group flex-1">
          <span class="cog-field-label">Floor</span>
          <select class="cog-field-input" name="system.details.floor">
            {{#each floorOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="cog-field-row">
        <div class="cog-field-group flex-2">
          <span class="cog-field-label">Bonded Owner</span>
          <div style="display: flex; align-items: center; gap: 6px; height: 26px;">
            {{#if owner}}
              <span class="cog-text-info" style="font-weight: bold; font-size: 12px;"><i class="fa-solid fa-link"></i> {{owner.name}}</span>
              <button type="button" class="cog-btn-xs cog-bg-info-fill cog-text-on-fill" data-action="vehicleOpenOwner" title="Open Owner Sheet" style="padding: 1px 6px; border: none; border-radius: 3px; cursor: pointer;">
                <i class="fa-solid fa-external-link"></i>
              </button>
              <button type="button" class="cog-btn-xs cog-bg-danger-fill cog-text-on-fill" data-action="vehicleUnlinkOwner" title="Unlink Owner" style="padding: 1px 6px; border: none; border-radius: 3px; cursor: pointer;">
                <i class="fa-solid fa-unlink"></i>
              </button>
            {{else}}
              <span class="cog-text-muted" style="font-style: italic; font-size: 12px;">Unowned Vehicle</span>
            {{/if}}
          </div>
        </div>
        <div class="cog-field-group flex-2">
          <span class="cog-field-label">Driver</span>
          <div style="display: flex; align-items: center; gap: 6px; height: 26px;">
            {{#if pilot}}
              <span class="cog-text-warning" style="font-weight: bold; font-size: 12px;"><i class="fa-solid fa-id-badge"></i> {{pilot.name}}</span>
              <button type="button" class="cog-btn-xs cog-bg-neutral-fill cog-text-on-fill" data-action="vehicleCrew" data-op="stepDown" data-uuid="{{pilot.uuid}}" title="Step Down (stay aboard)" style="padding: 1px 6px; border: none; border-radius: 3px; cursor: pointer;">
                Step Down
              </button>
            {{else}}
              <span class="cog-text-muted" style="font-style: italic; font-size: 12px;">No Driver</span>
            {{/if}}
          </div>
        </div>
        <div class="cog-field-group flex-1">
          <span class="cog-field-label">Seats (incl. driver)</span>
          <input class="cog-field-input" name="system.attributes.occupancy" type="number" min="0" step="1" value="{{system.attributes.occupancy}}" title="0 = no limit" />
        </div>
        <div class="cog-field-group flex-1">
          <span class="cog-field-label">Cargo</span>
          <input class="cog-field-input" name="system.attributes.cargoOccupancy" type="number" min="0" step="1" value="{{system.attributes.cargoOccupancy}}" />
        </div>
        <div class="cog-field-group flex-2">
          <span class="cog-field-label">Notes / Description</span>
          <input class="cog-field-input" name="system.details.notes" type="text" value="{{system.details.notes}}" placeholder="Vehicle notes..." />
        </div>
      </div>
{{!-- Crew roster (3.21 section 6.1). Controls are action delegates; the role select has no name. --}}
<div class="cog-field-row">
        <div class="cog-stat-block" style="border: 1px solid var(--cog-info); border-radius: 6px; overflow: hidden; min-width: 0; flex: 1 1 0;">
          <div class="{{#if crew.over}}cog-bg-warning-fill{{else}}cog-bg-info-fill{{/if}} cog-text-on-fill cog-vehicle-crew-header" style="padding: 6px 10px; font-weight: bold; font-size: 12px;">
            <i class="fa-solid fa-users"></i> {{crew.seatsLabel}}
          </div>
          <div style="padding: 8px;">
            {{#each crew.rows as |row|}}
              <div class="cog-vehicle-crew-row" data-uuid="{{row.uuid}}" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 6px; padding: 6px 0; border-bottom: 1px solid var(--cog-divider); font-size: 11px;">
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 6px; min-width: 0;">
                  <img class="cog-bg-icon-box" src="{{row.img}}" width="24" height="24" style="border-radius: 3px; object-fit: cover;" />
                  <span style="font-weight: bold;">{{row.name}}</span>
                  {{#if row.isPilot}}<span class="cog-badge cog-badge-info cog-bg-info-fill cog-text-on-fill">[DRIVER]</span>{{/if}}
                  {{#if row.ruleBreak}}<span class="cog-badge cog-badge-rule-break" title="Boarded past the seat limit">[RULE BREAK]</span>{{/if}}
                </div>
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px;">
                  {{> "systems/sprinter-rpg/templates/actors/parts/vehicle-role-select.hbs" uuid=row.uuid options=row.roleOptions}}
                  {{#unless row.isPilot}}
                    <button type="button" class="cog-btn-xs cog-bg-info-fill cog-text-on-fill" data-action="vehicleCrew" data-op="takeWheel" data-uuid="{{row.uuid}}" style="padding: 2px 6px; border: none; border-radius: 3px; cursor: pointer; font-size: 10px;">Take the Wheel</button>
                  {{/unless}}
                  <button type="button" class="cog-btn-xs cog-bg-neutral-fill cog-text-on-fill" data-action="vehicleCrew" data-op="disembark" data-uuid="{{row.uuid}}" style="padding: 2px 6px; border: none; border-radius: 3px; cursor: pointer; font-size: 10px;">Disembark</button>
                </div>
              </div>
            {{/each}}
            {{#each crew.missing as |m|}}
              <div class="cog-vehicle-crew-row cog-vehicle-crew-missing" data-uuid="{{m.uuid}}" style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--cog-divider); font-size: 11px;">
                <span class="cog-text-muted" style="font-style: italic;">Missing actor</span>
                <button type="button" class="cog-btn-xs cog-bg-danger-fill cog-text-on-fill" data-action="vehicleCrew" data-op="disembark" data-uuid="{{m.uuid}}" style="padding: 2px 6px; border: none; border-radius: 3px; cursor: pointer; font-size: 10px;">Remove</button>
              </div>
            {{/each}}
            {{#unless crew.aboard}}
              <div class="cog-text-muted" style="font-style: italic; font-size: 11px; padding: 6px 0;">Nobody aboard. Drop an actor here to board it.</div>
            {{/unless}}
          </div>
        </div>
</div>
