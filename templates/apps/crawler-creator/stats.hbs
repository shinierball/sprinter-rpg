<section class="cog-creator-section cog-stats-section">
  <div class="cog-section-header flexrow">
    <h3><i class="fa-solid fa-gauge-high"></i> ABILITY SCORES (STANDARD ARRAY: 2, 3, 4, 5, 6)</h3>
    <div class="cog-array-pool flexrow">
      <span class="pool-label">Standard Array Pool:</span>
      {{#each availableNumbers}}
        <span class="pool-num {{#if (eq this.used 'duplicate')}}duplicate{{else if this.used}}used{{else}}available{{/if}}">
          {{this.value}}
        </span>
      {{/each}}
    </div>
  </div>

  {{#unless statValidation.valid}}
    <div class="cog-validation-banner warning">
      <i class="fa-solid fa-triangle-exclamation"></i> {{statValidation.error}}
    </div>
  {{/unless}}

  <div class="cog-stats-grid">
    {{#each statList}}
      <div class="cog-stat-box flexcol">
        <span class="stat-short">{{this.short}}</span>
        <span class="stat-full">{{this.label}}</span>
        <select class="cog-stat-select" name="creator-stat-{{this.key}}" data-change-action="setStat" data-stat="{{this.key}}" data-prop="stats.{{this.key}}">
          <option value="" {{#unless this.value}}selected{{/unless}}>—</option>
          {{#each ../standardArray}}
            <option value="{{this}}" {{#if (eq ../value this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
    {{/each}}
  </div>
</section>
